// DreamGUI's holo foil over a rect block (UDreamHoloFoil).
// Edit this file, then rebuild -- the .uasset is an output.
//
// The rect block is drawn exactly as DreamUI_RectBlock draws it (MF_DreamUI_RectBlock: its shape, its effects, its style),
// and the foil is added over its colour within its alpha by DreamUIHoloFoil_Shade (DreamUIHoloFoil.ush), across the rect's own UV,
// before the clip. The component sets the foil parameters on its own instance.
VirtualFunction(Name="MF_DreamUI_Clip")
{
	Options = {
		Asset = Path(Plugins.DreamGUI, "Materials/MF_DreamUI_Clip");
		Description = "Generated from /DreamGUI/Materials/MF_DreamUI_Clip.MF_DreamUI_Clip";
	}

	Inputs = {
		opt float CoordinateInDataTex = 0.0;
		opt float Opacity = 1.0;
	}

	Outputs = {
		float Result;
	}
}
VirtualFunction(Name="MF_DreamWidgetProperty")
{
	Options = {
		Asset = Path(Plugins.DreamGUI, "Materials/MF_DreamWidgetProperty");
		Description = "Generated from /DreamGUI/Materials/MF_DreamWidgetProperty.MF_DreamWidgetProperty";
	}

	Inputs = {
		opt float CoordinateInDataTex = 0.0;
	}

	Outputs = {
		float FontMark;
		float ClipDataCoordinate;
		float2 WidgetSize;
		float2 WidgetCenterPosition;
	}
}
VirtualFunction(Name="MF_DreamUI_RectBlock")
{
	Options = {
		Asset = Path(Plugins.DreamGUI, "Materials/MF_DreamUI_RectBlock");
		Description = "Generated from /DreamGUI/Materials/MF_DreamUI_RectBlock.MF_DreamUI_RectBlock";
	}

	Inputs = {
		Texture2D MainTexture;
	}

	Outputs = {
		float3 Color;
		float Alpha;
	}
}
VirtualFunction(Name="MF_DreamUI_ConvertVertexColor")
{
	Options = {
		Asset = Path(Plugins.DreamGUI, "Materials/MF_DreamUI_ConvertVertexColor");
		Description = "Generated from /DreamGUI/Materials/MF_DreamUI_ConvertVertexColor.MF_DreamUI_ConvertVertexColor";
	}

	Inputs = {
		float3 Color;
	}

	Outputs = {
		float3 Result;
	}
}
// SelfContained, with the #include attached to the Custom node itself: see MF_DreamUI_RectBlock.dsf for why.
Function SelfContained float3 DreamUIHoloFoilApply(in float3 BaseColor, in float BaseAlpha, in float2 UV, in Texture2D MaskTex, in Texture2D RainbowTex,
	in float4 View, in float4 Pattern)
{
	#include "/Plugin/DreamGUI/Private/DreamUIHoloFoil.ush"
	return DreamUIHoloFoil_Shade(BaseColor, BaseAlpha, UV, MaskTex, MaskTexSampler, RainbowTex, RainbowTexSampler, View, Pattern);
}

Shader(Name="Materials/DreamUI_HoloFoilRect", Root="Plugin.DreamGUI")
{
	Properties = {
		TextureObjectParameter DreamUI_MainTexture = Path(Engine, "EngineResources/DefaultTexture") [
			Group="DreamUI";
			SamplerType="SAMPLERTYPE_Color";
		];
		ScalarParameter DreamUI_IsRenderByDreamUIRenderer = 0.0;
		TextureObjectParameter DreamUI_FoilMask = Path(Engine, "EngineResources/WhiteSquareTexture") [
			Group="Foil";
			SamplerType="SAMPLERTYPE_Color";
		];
		TextureObjectParameter DreamUI_FoilRainbow = Path(Engine, "EngineResources/WhiteSquareTexture") [
			Group="Foil";
			SamplerType="SAMPLERTYPE_Color";
		];
		VectorParameter DreamUI_FoilView = float4(0.0, 0.0, 0.8, 1.0) [
			Group="Foil";
		];
		VectorParameter DreamUI_FoilPattern = float4(2.5, 0.6, 48.0, 0.08) [
			Group="Foil";
		];
	}

	Settings = {
		// Graph, not the project default ThinCustom: see DreamUI_ImageAndFont.dsm.
		Backend = "Graph";
		Domain = "Surface";
		ShadingModel = "Unlit";
		BlendMode = "AlphaComposite";
		TwoSided = true;
	}

	Outputs = {
		float3 EmissiveColor;
		float Opacity;

		Base.EmissiveColor = EmissiveColor;
		Base.Opacity = Opacity;
	}

	Graph = {
		float MF_DreamWidgetProperty = MF_DreamWidgetProperty(default, OutputIndex=1);
		float3 MF_DreamUI_RectBlock = MF_DreamUI_RectBlock(DreamUI_MainTexture, OutputIndex=0);
		float MF_DreamUI_RectBlock_1 = MF_DreamUI_RectBlock(DreamUI_MainTexture, OutputIndex=1);
		float3 MF_DreamUI_ConvertVertexColor = MF_DreamUI_ConvertVertexColor((UE.Expression(Class="VertexColor", OutputType="float4")).rgb);
		float4 Multiply = (float4(MF_DreamUI_ConvertVertexColor, (UE.Expression(Class="VertexColor", OutputType="float4")).a) * float4(MF_DreamUI_RectBlock, MF_DreamUI_RectBlock_1));
		float2 UV = UE.Expression(Class="TextureCoordinate", OutputType="float2");
		float3 Foiled = DreamUIHoloFoilApply(Multiply.rgb, Multiply.a, UV, DreamUI_FoilMask, DreamUI_FoilRainbow, DreamUI_FoilView, DreamUI_FoilPattern);
		float4 FoiledColor = float4(Foiled, Multiply.a);
		float MF_DreamUI_Clip = MF_DreamUI_Clip(MF_DreamWidgetProperty, Multiply.a);
		#Region "DreamUIRenderer will do color.rgb * color.a for PremultiplyAlpha"
		float4 Multiply_1 = (FoiledColor * MF_DreamUI_Clip);
		float4 LinearInterpolate = lerp(Multiply_1, FoiledColor, DreamUI_IsRenderByDreamUIRenderer);
		#EndRegion

		EmissiveColor = LinearInterpolate;
		Opacity = MF_DreamUI_Clip;
	}

	Layout = {
		Comment(Name="DreamUIRenderer will do color.rgb * color.a for PremultiplyAlpha", X=1200, Y=-16, W=400, H=220, Color=float4(1.0, 1.0, 1.0, 1.0));
	}

}