{
  "about": [
    "The coverage matrix: which interactive control or behaviour has a driver test for which input under which configuration. COVERAGE.md explains the tags; coverage_matrix.py draws the table.",
    "rows: one per control or behaviour. classes are the UCLASSes of Source/DreamGUI/Public/Controls/*.h and Public/Interaction/*.h that the row stands for; areas are test-name prefixes after 'DreamGUI.' whose tests count for the row (\"Button\" means DreamGUI.Button.*, \"Controls.Button\" means DreamGUI.Controls.Button.*); text marks a control that takes keyboard text, the only rows with a Text column; na maps a cell to the reason it is not applicable -- the key is an input id, a configuration id, or \"Input.Config\".",
    "excluded: classes of those headers that are not rows, each with the reason. A class that is in neither list shows up as an unclassified row, all holes, until someone decides.",
    "inputs and configs are the columns; their tag is what a test registers with REGISTER_SIMPLE_AUTOMATION_TEST_TAGS. extraTags are further tags a test may carry (the static checks refuse any other)."
  ],
  "inputs": [
    { "id": "Pointer", "tag": "Pointer", "title": "Mouse" },
    { "id": "Touch", "tag": "Touch", "title": "Touch" },
    { "id": "Nav", "tag": "Nav", "title": "Gamepad and keyboard navigation" },
    { "id": "Text", "tag": "Text", "title": "Keyboard text", "textRowsOnly": true }
  ],
  "configs": [
    { "id": "Default", "tag": "Animated", "title": "Default configuration, transitions and animations running" },
    { "id": "Disabled", "tag": "Disabled", "title": "Disabled, or made non-interactable" },
    { "id": "Scaled", "tag": "Scaled", "title": "Scaled canvas (a reference resolution other than the viewport)" },
    { "id": "World", "tag": "World", "title": "World space (a panel in the level, hit through a camera)" }
  ],
  "extraTags": [],
  "rows": [
    { "id": "Border", "classes": ["UDreamBorder"], "areas": ["Border", "Controls.Border"] },
    { "id": "Button", "classes": ["UDreamButton", "UUIButton"], "areas": ["Button", "Controls.Button"] },
    { "id": "Dialog", "classes": ["UDreamDialog", "UDreamDialogScope"], "areas": ["Dialog", "Controls.Dialog"] },
    { "id": "Dropdown", "classes": ["UDreamDropdown", "UUIDropdown", "UUIDropdownItemComponent"], "areas": ["Dropdown", "Controls.Dropdown"] },
    { "id": "EditableText", "classes": ["UDreamEditableText"], "areas": ["EditableText", "Controls.EditableText"], "text": true },
    { "id": "MultiLineEditableText", "classes": ["UDreamMultiLineEditableText"], "areas": ["MultiLineEditableText", "Controls.MultiLineEditableText"], "text": true },
    { "id": "TextInput", "classes": ["UDreamTextInput", "UUITextInput"], "areas": ["TextInput", "Controls.TextInput"], "text": true },
    { "id": "SpinBox", "classes": ["UDreamSpinBox"], "areas": ["SpinBox", "Controls.SpinBox"], "text": true },
    { "id": "InputKeySelector", "classes": ["UDreamInputKeySelector"], "areas": ["InputKeySelector", "Controls.InputKeySelector"], "text": true, "note": "Its Text column is the key it listens for, not characters." },
    { "id": "ExpandableArea", "classes": ["UDreamExpandableArea"], "areas": ["ExpandableArea", "Controls.ExpandableArea"] },
    { "id": "ListView", "classes": ["UDreamListView", "UUIListView", "UUIListEntry", "UDreamListRowButton"], "areas": ["ListView", "Controls.List"] },
    { "id": "ListRowDragDrop", "classes": ["UDreamListRowDragSource", "UDreamListRowDropTarget"], "areas": ["ListRowDragDrop"] },
    { "id": "TileView", "classes": ["UDreamTileView", "UUITileView"], "areas": ["TileView", "Controls.TileView"] },
    { "id": "TreeView", "classes": ["UDreamTreeView", "UUITreeView"], "areas": ["TreeView", "Controls.TreeView"] },
    { "id": "MenuAnchor", "classes": ["UDreamMenuAnchor"], "areas": ["MenuAnchor", "Controls.MenuAnchor"] },
    { "id": "NativeWidgetHost", "classes": ["UDreamNativeWidgetHost"], "areas": ["NativeWidgetHost", "Controls.NativeWidgetHost"] },
    { "id": "ProgressBar", "classes": ["UDreamProgressBar", "UUIProgressBar"], "areas": ["ProgressBar", "Controls.ProgressBar", "Controls.ProgressBarBehaviour"] },
    { "id": "RadioButton", "classes": ["UDreamRadioButton"], "areas": ["RadioButton", "Controls.RadioButton"] },
    { "id": "RichText", "classes": ["UDreamRichTextBlock", "UUITextHyperlink"], "areas": ["RichText", "Controls.RichText"] },
    { "id": "RingMenu", "classes": ["UDreamRingMenu"], "areas": ["RingMenu", "Controls.RingMenu"] },
    { "id": "ScrollBar", "classes": ["UDreamScrollBar", "UUIScrollbar"], "areas": ["ScrollBar", "Controls.ScrollBar", "Interaction.Scrollbar"] },
    { "id": "ScrollBox", "classes": ["UDreamScrollBox", "UUIScrollView", "UUIScrollViewWithScrollbar", "UUIRecyclableScrollView"], "areas": ["ScrollBox", "ScrollView", "Controls.ScrollBox", "Interaction.ScrollView"] },
    { "id": "Slider", "classes": ["UDreamSlider", "UUISlider"], "areas": ["Slider", "Controls.Slider"] },
    { "id": "TabView", "classes": ["UDreamTabView"], "areas": ["TabView", "Controls.TabView"] },
    { "id": "Toggle", "classes": ["UDreamToggle", "UUIToggle"], "areas": ["Toggle", "Controls.Toggle", "Interaction.Toggle"] },
    { "id": "ToggleGroup", "classes": ["UUIToggleGroup"], "areas": ["ToggleGroup"] },
    { "id": "EventBlocker", "classes": ["UUIEventBlocker"], "areas": ["EventBlocker"] },
    { "id": "EventTrigger", "classes": ["UUIEventTrigger"], "areas": ["EventTrigger"] },
    { "id": "DragDrop", "classes": ["UDreamUIDragSource", "UDreamUIDropTarget", "UDreamUIDragDropSubsystem", "UDreamDragDropOperation"], "areas": ["DragDrop"] },
    { "id": "NavigationScope", "classes": ["UDreamUINavigationScope", "UUINavigationInputSelectionHandler"], "areas": ["NavigationScope", "Navigation.Scope"] },
    { "id": "NavigationStack", "classes": ["UDreamUINavigationStack"], "areas": ["NavigationStack", "Navigation.Back"] },
    { "id": "ActionRouter", "classes": ["UDreamUIActionRouter", "UDreamUIActionTrigger"], "areas": ["ActionRouter", "Navigation.Actions"] },
    { "id": "ActionBar", "classes": ["UDreamUIActionBar", "UDreamUIActionBarEntry"], "areas": ["ActionBar", "Navigation.ActionBar"] },
    { "id": "Modal", "classes": ["UDreamUIModalScope", "UDreamUIModalSubsystem"], "areas": ["Modal"] },
    { "id": "PopupLayer", "classes": ["UDreamUIPopupLayer"], "areas": ["PopupLayer"] },
    { "id": "Tooltip", "classes": ["UDreamUITooltipSubsystem"], "areas": ["Tooltip"] },
    { "id": "VirtualCursor", "classes": ["UDreamUIVirtualCursorSubsystem"], "areas": ["VirtualCursor"] }
  ],
  "excluded": [
    { "class": "UDreamUIControl", "reason": "Abstract base of every control; covered through the concrete controls." },
    { "class": "UDreamListViewBase", "reason": "Abstract base of the list, tile and tree views; covered through them." },
    { "class": "UUISelectable", "reason": "The selectable behaviour every button, toggle, slider and field is built on; covered through those rows." },
    { "class": "UUITransition", "reason": "Abstract transition base; transitions are what the Default (animated) column exercises on each control." },
    { "class": "UUISelectableTransition", "reason": "Abstract transition base; see UUITransition." },
    { "class": "UUIToggleTransition", "reason": "Abstract transition base; see UUITransition." },
    { "class": "UUIScrollViewHelper", "reason": "Transient helper the scroll view creates for itself; not placed by anyone." },
    { "class": "UDreamThrobber", "reason": "A busy indicator: draws, takes no input." },
    { "class": "UDreamUIStyleSheet", "reason": "A data asset of styles, not a widget." },
    { "class": "UDreamSelectableStyle", "reason": "A data asset of styles, not a widget." },
    { "class": "UDreamTextInputCustomValidation", "reason": "A validation object a text field consults; it takes no input of its own." },
    { "class": "UDreamContentWidget", "reason": "A content slot for composition; takes no input." },
    { "class": "UDreamNamedSlotHost", "reason": "A named-slot container for composition; takes no input." },
    { "class": "UDreamNamedSlot", "reason": "A named slot for composition; takes no input." },
    { "class": "UDreamDataBinding", "reason": "Binds data to properties; takes no input." },
    { "class": "UDreamResponsiveBehaviour", "reason": "Rearranges widgets by viewport size, not by input; interacting after a breakpoint switch is tested on the controls it rearranges." },
    { "class": "UDreamLayoutSelfSpacer", "reason": "A layout spacer; takes no input." }
  ]
}
