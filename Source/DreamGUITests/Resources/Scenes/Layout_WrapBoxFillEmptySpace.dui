// Fill-empty-space in a 300-wide wrap box: as in UMG, only the last slot of a line grows into what the line leaves.
// The slots get their size from SizeBox overrides (a label places itself, so the box keeps them): an Image
// measures as its sprite, not as Brush.ImageSize.
// @stage 512x256

style Title {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (1, 1)
    AnchorData.Pivot = (0.5, 1)
    AnchorData.AnchoredPosition = (0, -8)
    AnchorData.SizeDelta = (-24, 20)
    FontSize = 15
    Color = #1E2230
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Note {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
    FontSize = 12
    Color = #5A6172
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Box {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
}

style InBox {
    bIgnoreLayout = true
    AnchorData.SizeDelta = (100, 16)
    FontSize = 12
    Color = #FFFFFF
    HAlign = Center
    VAlign = Middle
    OverflowType = HorizontalOverflow
}

Widget Root {
    Image Page {
        Brush.TintColor = #F5F3EE
        AnchorData.AnchorMin = (0, 0)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.SizeDelta = (0, 0)
    }

    Text Heading : Title {
        Text = "WrapBox, bFillEmptySpace, two 100-wide slots in 300"
    }

    Image FirstWrap : Box {
        Brush.TintColor = #C9D3E6
        AnchorData.AnchoredPosition = (24, -48)
        AnchorData.SizeDelta = (300, 40)
        + WrapBox {}

        Image FirstA {
            Brush.TintColor = #3D7DD8
            + SizeBox {
                bOverrideWidth = true
                WidthOverride = 100
                bOverrideHeight = true
                HeightOverride = 40
            }
            @slot bFillEmptySpace = true
            Text FirstALabel : InBox { Text = "A, fill" }
        }
        Image FirstB {
            Brush.TintColor = #2BA36B
            + SizeBox {
                bOverrideWidth = true
                WidthOverride = 100
                bOverrideHeight = true
                HeightOverride = 40
            }
            Text FirstBLabel : InBox { Text = "B, 100" }
        }
    }

    Text FirstExpected : Note {
        AnchorData.AnchoredPosition = (24, -92)
        AnchorData.SizeDelta = (464, 16)
        Text = "A asks to fill but is not last on its line: nothing grows, 100 of grey is left."
    }

    Image SecondWrap : Box {
        Brush.TintColor = #C9D3E6
        AnchorData.AnchoredPosition = (24, -128)
        AnchorData.SizeDelta = (300, 40)
        + WrapBox {}

        Image SecondA {
            Brush.TintColor = #3D7DD8
            + SizeBox {
                bOverrideWidth = true
                WidthOverride = 100
                bOverrideHeight = true
                HeightOverride = 40
            }
            Text SecondALabel : InBox { Text = "A, 100" }
        }
        Image SecondB {
            Brush.TintColor = #2BA36B
            + SizeBox {
                bOverrideWidth = true
                WidthOverride = 100
                bOverrideHeight = true
                HeightOverride = 40
            }
            @slot bFillEmptySpace = true
            Text SecondBLabel : InBox { Text = "B, fill" }
        }
    }

    Text SecondExpected : Note {
        AnchorData.AnchoredPosition = (24, -172)
        AnchorData.SizeDelta = (464, 16)
        Text = "B fills and is last on its line: it grows to 200, no grey is left."
    }
}
