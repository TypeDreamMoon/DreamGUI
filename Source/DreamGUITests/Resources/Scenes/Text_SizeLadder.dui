        FontSize = 24
    }

    Text Label32 : Size {
        AnchorData.AnchoredPosition = (8, -264)
        Text = "32 px"
    }
    Text Sample32 : Sample {
        AnchorData.AnchoredPosition = (60, -264)
        AnchorData.SizeDelta = (732, 44)
        FontSize = 32
    }

    Text Label48 : Size {
        AnchorData.AnchoredPosition = (8, -310)
        Text = "48 px"
    }
    Text Sample48 : Sample {
        AnchorData.AnchoredPosition = (60, -310)
        AnchorData.SizeDelta = (732, 66)
        FontSize = 48
    }
}
