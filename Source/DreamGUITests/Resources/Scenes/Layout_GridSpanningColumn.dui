// A grid whose first row is one child across both columns: each column is as wide as the widest of its own children
// and an equal share of the spanning one (UMG's rule), whatever order the children come in.
// The cells get their size from SizeBox overrides (a label places itself, so the box keeps them): an Image
// measures as its sprite, not as Brush.ImageSize.
// @stage 512x256

style Title {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (1, 1)
    AnchorData.Pivot = (0.5, 1)
    AnchorData.AnchoredPosition = (0, -8)
    AnchorData.SizeDelta = (-24, 20)
    FontSize = 15
    Color = #1E2230
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Note {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
    FontSize = 12
    Color = #5A6172
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Box {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
}

style InBox {
    bIgnoreLayout = true
    AnchorData.SizeDelta = (200, 16)
    FontSize = 12
    Color = #FFFFFF
    HAlign = Center
    VAlign = Middle
    OverflowType = HorizontalOverflow
}

Widget Root {
    Image Page {
        Brush.TintColor = #F5F3EE
        AnchorData.AnchorMin = (0, 0)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.SizeDelta = (0, 0)
    }

    Text Heading : Title {
        Text = "GridPanel with a child across two columns"
    }

    Image Grid : Box {
        Brush.TintColor = #C9D3E6
        AnchorData.AnchoredPosition = (24, -48)
        AnchorData.SizeDelta = (320, 80)
        + GridPanel {}

        Image CellA {
            Brush.TintColor = #3D7DD8
            + SizeBox {
                bOverrideWidth = true
                WidthOverride = 200
                bOverrideHeight = true
                HeightOverride = 40
            }
            @slot Row = 0
            @slot Column = 0
            @slot ColumnSpan = 2
            Text LabelA : InBox { Text = "A: columns 0-1, wants 200" }
        }

        Image CellB {
            Brush.TintColor = #2BA36B
            + SizeBox {
                bOverrideWidth = true
                WidthOverride = 150
                bOverrideHeight = true
                HeightOverride = 40
            }
            @slot Row = 1
            @slot Column = 0
            Text LabelB : InBox {
                Text = "B: wants 150"
                AnchorData.SizeDelta = (150, 16)
            }
        }

        Image CellC {
            Brush.TintColor = #F2C14E
            + SizeBox {
                bOverrideWidth = true
                WidthOverride = 20
                bOverrideHeight = true
                HeightOverride = 40
            }
            @slot Row = 1
            @slot Column = 1
            @slot HorizontalAlignment = Fill
            Text LabelC : InBox {
                Text = "C fills"
                AnchorData.SizeDelta = (100, 16)
                Color = #1E2230
            }
        }
    }

    Text Expected : Note {
        AnchorData.AnchoredPosition = (24, -144)
        AnchorData.SizeDelta = (464, 48)
        Text = "Expected: column 0 is 150 (B), column 1 is 100 (half of A's 200)\nand C fills it; A spans 250. The grey to the right is the grid's own\nspare width."
    }
}
