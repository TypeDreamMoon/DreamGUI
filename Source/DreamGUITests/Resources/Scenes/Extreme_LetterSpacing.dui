    Text UnderlineZero : Cell {
        AnchorData.AnchoredPosition = (728, -200)
        bUnderline = true
    }
    Text UnderlinePlus3 : Cell {
        AnchorData.AnchoredPosition = (1012, -200)
        FontSpace = (3, 0)
        bUnderline = true
    }

    Text RowAlpha : Note {
