        AnchorData.SizeDelta = (136, 32)
        Text = "bitmap font,\nshadow + outline"
    }
    Text Font_Bitmap_Minus5 : Cell {
        AnchorData.AnchoredPosition = (160, -336)
        FontSpace = (-5, 0)
        TextStyle.UnderlayColor = #00000099
        TextStyle.UnderlayOffset = (0.06, 0.06)
        TextStyle.OutlineColor = #F2C14EFF
        TextStyle.OutlineWidth = 0.06
    }
    Text Font_Bitmap_Minus2 : Cell {
        AnchorData.AnchoredPosition = (444, -336)
