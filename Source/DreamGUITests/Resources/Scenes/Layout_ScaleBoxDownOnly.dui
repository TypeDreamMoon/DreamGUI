// A scale box that fits its width but may only shrink, holding 100 x 50 art in a 400-wide vertical box: there is
// room to grow and it may not, so the art stays 100 x 50 -- in the measurement as well as the arrangement -- and the
// sibling under it starts 50 down.
// The art and the sibling get their size from SizeBox overrides (a label places itself, so the box keeps them): an
// Image measures as its sprite, not as Brush.ImageSize.
// @stage 512x288

style Title {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (1, 1)
    AnchorData.Pivot = (0.5, 1)
    AnchorData.AnchoredPosition = (0, -8)
    AnchorData.SizeDelta = (-24, 20)
    FontSize = 15
    Color = #1E2230
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Note {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
    FontSize = 12
    Color = #5A6172
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Box {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
}

style InBox {
    bIgnoreLayout = true
    AnchorData.SizeDelta = (200, 16)
    FontSize = 12
    Color = #FFFFFF
    HAlign = Center
    VAlign = Middle
    OverflowType = HorizontalOverflow
}

Widget Root {
    Image Page {
        Brush.TintColor = #F5F3EE
        AnchorData.AnchorMin = (0, 0)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.SizeDelta = (0, 0)
    }

    Text Heading : Title {
        Text = "ScaleBox, ScaleToFitX, DownOnly, 100 x 50 art in 400"
    }

    Image Column : Box {
        Brush.TintColor = #EEF1F7
        AnchorData.AnchoredPosition = (24, -48)
        AnchorData.SizeDelta = (400, 196)
        + VerticalBox {
            Spacing = 8
        }

        Image Scaler {
            Brush.TintColor = #AEB9CF
            + ScaleBox {
                Stretch = ScaleToFitX
                StretchDirection = DownOnly
            }
            @slot SizeRule = Auto

            Image Art {
                Brush.TintColor = #3D7DD8
                + SizeBox {
                    bOverrideWidth = true
                    WidthOverride = 100
                    bOverrideHeight = true
                    HeightOverride = 50
                }
                Text ArtLabel : InBox {
                    Text = "100 x 50"
                    AnchorData.SizeDelta = (100, 16)
                }
            }
        }

        Image Below {
            Brush.TintColor = #F2C14E
            + SizeBox {
                bOverrideHeight = true
                HeightOverride = 24
            }
            @slot SizeRule = Auto
            Text BelowLabel : InBox {
                Text = "sibling, 8 under the 50-tall box"
                Color = #1E2230
            }
        }
    }

    Text Expected : Note {
        AnchorData.AnchoredPosition = (24, -252)
        AnchorData.SizeDelta = (464, 32)
        Text = "Expected: DownOnly never enlarges, so the art stays 100 x 50, centred,\nand the grey scale box is 50 tall."
    }
}
