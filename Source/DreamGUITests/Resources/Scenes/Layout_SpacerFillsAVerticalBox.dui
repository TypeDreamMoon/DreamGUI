// A Spacer in the Fill slot of a vertical box takes the height the two bars leave, and the box settles on that size
// instead of the two of them rewriting each other's size every pass.
// The bars get their height from SizeBox overrides (a label places itself, so the box keeps them): an Image
// measures as its sprite, not as Brush.ImageSize.
// @stage 512x512

style Title {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (1, 1)
    AnchorData.Pivot = (0.5, 1)
    AnchorData.AnchoredPosition = (0, -8)
    AnchorData.SizeDelta = (-24, 20)
    FontSize = 15
    Color = #1E2230
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Note {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
    FontSize = 12
    Color = #5A6172
    HAlign = Left
    VAlign = Top
    OverflowType = HorizontalOverflow
}

style Box {
    AnchorData.AnchorMin = (0, 1)
    AnchorData.AnchorMax = (0, 1)
    AnchorData.Pivot = (0, 1)
}

style InBox {
    bIgnoreLayout = true
    AnchorData.SizeDelta = (190, 16)
    FontSize = 12
    Color = #FFFFFF
    HAlign = Center
    VAlign = Middle
    OverflowType = HorizontalOverflow
}

Widget Root {
    Image Page {
        Brush.TintColor = #F5F3EE
        AnchorData.AnchorMin = (0, 0)
        AnchorData.AnchorMax = (1, 1)
        AnchorData.SizeDelta = (0, 0)
    }

    Text Heading : Title {
        Text = "Spacer in the Fill slot of a VerticalBox"
    }

    Image Column : Box {
        Brush.TintColor = #C9D3E6
        AnchorData.AnchoredPosition = (24, -48)
        AnchorData.SizeDelta = (200, 420)
        + VerticalBox {}

        Image TopBar {
            Brush.TintColor = #3D7DD8
            + SizeBox {
                bOverrideHeight = true
                HeightOverride = 40
            }
            @slot SizeRule = Auto
            Text TopLabel : InBox { Text = "Auto, 40" }
        }

        Image Gap {
            Brush.TintColor = #F2C14E
            + Spacer {
                Size = (32, 32)
            }
            @slot SizeRule = Fill
            Text GapLabel : InBox {
                Text = "Spacer, Fill: 340"
                Color = #1E2230
            }
        }

        Image BottomBar {
            Brush.TintColor = #3D7DD8
            + SizeBox {
                bOverrideHeight = true
                HeightOverride = 40
            }
            @slot SizeRule = Auto
            Text BottomLabel : InBox { Text = "Auto, 40" }
        }
    }

    Text Expected : Note {
        AnchorData.AnchoredPosition = (240, -48)
        AnchorData.SizeDelta = (260, 64)
        Text = "Expected: blue 40, yellow 340,\nblue 40, filling the 420-tall\ngrey column with none of it showing."
    }
}
