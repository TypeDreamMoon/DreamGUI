    { "id": "Justify_Latin", "text": "Justified text spreads the room a line lacks over the spaces between its words, and its last line keeps to the start.", "font": "Latin", "size": 16, "width": 260, "align": "justify", "wrap": "normal", "canvas": [512, 160], "flags": ["breaks"] },
    { "id": "Justify_Japanese", "text": "日本語の文章を両端揃えにすると、行に足りない幅が文字の間に配られます。", "font": "CJK", "size": 20, "width": 230, "lang": "ja", "align": "justify", "canvas": [512, 192], "flags": ["breaks"] },
    { "id": "Justify_HebrewRtl", "text": "שלום עולם, זו פסקה מיושרת לשני הצדדים, מימין לשמאל, עם כמה מילים נוספות.", "font": "Hebrew", "size": 20, "width": 260, "lang": "he", "dir": "rtl", "align": "justify", "wrap": "normal", "canvas": [512, 160], "flags": ["breaks"] },
    { "id": "Justify_LastLine", "text": "Here every line is justified, the last one and the one a newline ends\nas well, because text-align-last says so.", "font": "Latin", "size": 16, "width": 260, "align": "justify", "textAlignLast": "justify", "wrap": "normal", "canvas": [512, 192], "flags": ["breaks"] },

    { "id": "Tabs_Default", "text": "a\tbb\tccc\tdddd\t1\t22", "font": "Latin", "size": 24, "tabSize": 8, "canvas": [768, 80] },
    { "id": "Tabs_Size4", "text": "a\tbb\tccc\tdddd\t1\t22", "font": "Latin", "size": 24, "tabSize": 4, "canvas": [768, 80] },
    { "id": "Tabs_Wrapped", "text": "Name:\tvalue one\tvalue two\tvalue three\tvalue four", "font": "Latin", "size": 20, "width": 260, "wrap": "normal", "tabSize": 8, "canvas": [512, 160] },
    { "id": "Tabs_LetterSpacing", "text": "a\tb\tc\td", "font": "Latin", "size": 24, "letterSpacing": 2, "tabSize": 8, "canvas": [768, 80] },

    { "id": "Layout_Whitespace", "text": "a  b\tc", "font": "Latin", "size": 32, "canvas": [512, 96] },
    { "id": "Layout_CentredPadded", "text": "  padded  ", "font": "Latin", "size": 32, "width": 300, "align": "center", "canvas": [512, 96] },
    { "id": "Layout_EllipsisLtr", "text": "The quick brown fox jumps over the lazy dog", "font": "Latin", "size": 20, "width": 200, "overflow": "ellipsis", "canvas": [512, 80] },
    { "id": "Layout_EllipsisRtl", "text": "שלום עולם זהו משפט ארוך מאוד", "font": "Hebrew", "size": 20, "width": 200, "overflow": "ellipsis", "lang": "he", "dir": "rtl", "canvas": [512, 80] },
    { "id": "Ellipsis_Middle", "text": "The quick brown fox jumps over the lazy dog", "font": "Latin", "size": 20, "width": 200, "overflow": "middleEllipsis", "reference": "slate", "canvas": [512, 80], "flags": ["reportOnly"] },
    { "id": "Layout_Clamp3", "text": "The quick brown fox jumps over the lazy dog, then naps in the sun for most of the afternoon while the clouds go by.", "font": "Latin", "size": 20, "width": 240, "overflow": "clamp", "maxLines": 3, "canvas": [512, 160] },
    { "id": "Layout_RtlDefaultAlign", "text": "שלום עולם, זו פסקה מימין לשמאל עם יישור ברירת מחדל.", "font": "Hebrew", "size": 24, "width": 400, "lang": "he", "dir": "rtl", "canvas": [512, 160], "flags": ["breaks"], "variants": ["narrow"] },
    { "id": "Layout_LineHeight50", "text": "Line height half of the font's own, three lines of it.", "font": "Latin", "size": 24, "width": 220, "lineHeight": "50%", "canvas": [512, 160] },
    { "id": "Layout_LineHeight150", "text": "Line height half again the font's own, three lines.", "font": "Latin", "size": 24, "width": 220, "lineHeight": "150%", "canvas": [512, 192] },
