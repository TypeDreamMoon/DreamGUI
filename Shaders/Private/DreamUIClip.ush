#ifndef DREAMUI_CLIP_USH
#define DREAMUI_CLIP_USH

// The third slot of the last column is RESERVED and not read: FDreamUIClipData::UpdateData writes a
// zero there and nothing has ever consumed it. It used to arrive here as an out parameter named
// Softness, which made the layout look like it carried a soft-clip width that some branch honoured --
// no branch did, and neither Slate's clipping nor UMG's has such a control to copy. The clip edge is
// antialiased from the signed distance field's own derivative, which is what the two branches below
// do. The slot stays in the layout because the matrix is uploaded whole; the parameter is gone
// because a name in a signature is a promise.
void DreamUI_ReadClipData(Texture2D DataTex, inout int3 Position, out float4x4 CanvasToClipMatrix, out float HalfWidth, out float HalfHeight, out float IsValid)
{
	float4 Column0 = DataTex.Load(Position);Position.x += 1;
	float4 Column1 = DataTex.Load(Position);Position.x += 1;
	float4 Column2 = DataTex.Load(Position);Position.x += 1;
	float4 Column3 = DataTex.Load(Position);Position.x += 1;
	HalfWidth = Column3.x;
	HalfHeight = Column3.y;
	//Column3.z is the reserved slot described above
	IsValid = Column3.w;
	Column3 = float4(0, 0, 0, 1);
	CanvasToClipMatrix[0] = Column0;
	CanvasToClipMatrix[1] = Column1;
	CanvasToClipMatrix[2] = Column2;
	CanvasToClipMatrix[3] = Column3;
}
// reference from https://www.shadertoy.com/view/4tGGRm
float DreamUIClip_sdRoundRect(float2 p, float2 b, float4 r)
{
	r.xyzw = min(r.xyzw, min(b.x, b.y));
	r.xy = (p.x > 0.0) ? r.xy : r.wz;
	r.x = (p.y > 0.0) ? r.x : r.y;
	float2 q = abs(p) - b + r.x;
	float d = min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r.x;
	return d;
}
#define DreamUI_Clip_Depth 16
#define DreamUI_Clip_Enable_Rounded 1
float DreamUI_CalculateClipData(Texture2D DataTex, float CoordinateInDataTex, float3 PixelLocalPosition)
{
	int Coordinate = round(CoordinateInDataTex);
	if (Coordinate == 0) return 1.0f;//0 position means no clip
	float finalAlpha = 1.0f;
	int3 Position = int3(0, Coordinate, 0);
	for (int i = 0; i < DreamUI_Clip_Depth; i++)
	{
		float4x4 CanvasToClipMatrix;
		float HalfWidth, HalfHeight;
		float IsValid = 1;
		DreamUI_ReadClipData(DataTex, Position, CanvasToClipMatrix, HalfWidth, HalfHeight, IsValid);
		if (!IsValid)break;

		float3 PixelPosition = mul(CanvasToClipMatrix, float4(PixelLocalPosition.xyz, 1.0)).xyz;
		// The CPU writes matrix + corner radius for every clip level (FDreamUIClipData::SingleBlockSizeInBytes),
		// so the read has to step past the corner radius whether or not this permutation uses it.
		// Stepping only inside the rounded branch left every deeper level reading one texel early.
		float4 CornerRadius = DataTex.Load(Position);Position.x += 1;
#if DreamUI_Clip_Enable_Rounded
		float Alpha = DreamUIClip_sdRoundRect(PixelPosition.yz, float2(HalfWidth, HalfHeight), CornerRadius);
		Alpha = Alpha / fwidth(Alpha);
		// Centred on the boundary; see the long note in DreamUIRectBlock.ush. Distance is negative
		// inside, so the half pixel is subtracted. A clip rect needs no skirt of its own -- it ramps
		// across whatever geometry is being clipped, which by definition extends past the edge.
		Alpha = saturate(0.5f - Alpha);
		finalAlpha *= Alpha;
#else
		float2 Alpha2 = abs(PixelPosition.yz) - float2(HalfWidth, HalfHeight);
		Alpha2 = saturate(Alpha2);
		float Alpha = 1.0 - saturate(Alpha2.x + Alpha2.y);
		finalAlpha *= Alpha;
#endif
	}
	return finalAlpha;
}

#endif // DREAMUI_CLIP_USH
