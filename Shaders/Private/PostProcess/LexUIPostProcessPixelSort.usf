#include "LexUIPostProcessVertexShader.usf"
#include "/Engine/Public/Platform.ush"
#include "/Engine/Generated/UniformBuffers/LexUIPostProcessMainTexUB.ush"

// Pixel sorting in TWO passes, by computing each texel's destination directly instead of shuffling
// it there one step at a time.
//
// The approach is taken from mizt's Shadertoy implementation, and it is a better fit than the
// odd-even transposition this replaced. A transposition sort needs one pass per texel of travel, so
// it is expensive AND only partially sorts; this scans each texel's own run once, counts how many
// neighbours belong before it, and lands it in exactly the right place. Two passes, exact result.
//
// Pass 1 (RankPS) writes WHERE EACH TEXEL IS GOING. Pass 2 (GatherPS) inverts that into WHO COMES
// HERE, because a pixel shader can only ever gather.
//
// This file mirrors namespace LexPixelSort in LexPixelSort.cpp. The two cannot share code -- one is
// HLSL -- so they are kept in step by hand, and anything added here belongs there too.

float2 _RegionSize;     // texels along x and y
float2 _Band;           // threshold band, already ordered low then high
float  _SortAxis;       // 0 = horizontal (sort along x), 1 = vertical (sort along y)
float  _SortKey;        // matches ELexPixelSortKey
float  _Descending;
float  _SearchRadius;   // how far a texel may look, and therefore how far it may travel
float4 _IntervalParams; // x = ELexPixelSortInterval, y = interval length, z = randomness, w unused

// Mirrors LexPixelSort::ComputeKey. Order matches ELexPixelSortKey exactly.
float ComputeKey(float4 color)
{
    float maxChannel = max(color.r, max(color.g, color.b));
    float minChannel = min(color.r, min(color.g, color.b));

    if (_SortKey < 0.5)         // Luminance
    {
        return dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
    }
    else if (_SortKey < 1.5)    // Brightness
    {
        return maxChannel;
    }
    else if (_SortKey < 2.5)    // Saturation
    {
        return maxChannel > 0.00001 ? (maxChannel - minChannel) / maxChannel : 0.0;
    }
    else if (_SortKey < 3.5)    // Hue -- wraps, so a run spanning red splits rather than sorting
    {
        float chroma = maxChannel - minChannel;
        if (chroma <= 0.00001)
        {
            return 0.0;
        }
        float hue;
        if (maxChannel == color.r)      hue = (color.g - color.b) / chroma;
        else if (maxChannel == color.g) hue = 2.0 + (color.b - color.r) / chroma;
        else                            hue = 4.0 + (color.r - color.g) / chroma;
        hue /= 6.0;
        return hue < 0.0 ? hue + 1.0 : hue;
    }
    else if (_SortKey < 4.5)    // Intensity
    {
        return (color.r + color.g + color.b) / 3.0;
    }
    else if (_SortKey < 5.5)    // Minimum
    {
        return minChannel;
    }
    return color.a;             // Alpha
}

// Mirrors LexPixelSort::Hash.
uint LexHash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

// Mirrors LexPixelSort::IsInBand. Saturated for the band test ONLY -- the band is authored in 0..1
// but the key comes from whatever format the backbuffer is, and on a float target values above 1 are
// ordinary. Clamping the comparison itself would freeze every highlight out of the sort.
bool IsInBand(float key)
{
    float clamped = saturate(key);
    return clamped >= _Band.x && clamped <= _Band.y;
}

// Mirrors LexPixelSort::IsSortable. Threshold asks the image; Random and Waves ask only the
// position, which is why they impose a pattern instead of following one. A texel that is not
// sortable is a WALL: it never moves, and it ends the runs on either side of it.
bool IsSortable(float key, int index, int lineIndex)
{
    uint lineSeed = LexHash((uint)lineIndex * 0x9e3779b9u);
    int length = max((int)_IntervalParams.y, 2);
    int mode = (int)(_IntervalParams.x + 0.5);
    int runIndex = 0;

    if (mode == 0)          // Threshold
    {
        if (!IsInBand(key))
        {
            return false;
        }
        runIndex = index / length;
    }
    else if (mode == 2)     // Waves
    {
        runIndex = index / length;
        if ((uint)(index % length) == (lineSeed % (uint)length))
        {
            return false;
        }
    }
    else if (mode == 1)     // Random
    {
        runIndex = index / length;
        uint roll = LexHash(lineSeed ^ ((uint)index * 0x85ebca6bu));
        if ((roll % (uint)length) == 0u)
        {
            return false;
        }
    }
    // mode == 3 (None): everything takes part, runIndex stays 0

    if (_IntervalParams.z > 0.0)
    {
        uint roll = LexHash(lineSeed ^ ((uint)runIndex * 0xc2b2ae35u));
        if ((roll & 0xffffffu) < (uint)(_IntervalParams.z * 16777215.0))
        {
            return false;
        }
    }
    return true;
}

// Sample the texel at a given position along the line, in the line's own coordinates.
float4 SampleAt(float2 uv, float alongIndex, bool bVertical)
{
    float2 texel = floor(uv * _RegionSize);
    float2 target = bVertical ? float2(texel.x, alongIndex) : float2(alongIndex, texel.y);
    return LexUIPostProcessMainTexUB._MainTex.SampleLevel(LexUIPostProcessMainTexUB._MainTexSampler,
        (target + 0.5) / _RegionSize, 0.0);
}

// ------------------------------------------------------------------------------------------------
// Pass 1 -- where does this texel belong?
// ------------------------------------------------------------------------------------------------
float4 RankPS(SimpleVSToPS input) : SV_Target0
{
    bool bVertical = _SortAxis > 0.5;
    float lineLength = bVertical ? _RegionSize.y : _RegionSize.x;
    float2 texel = floor(input.uv * _RegionSize);
    float index = bVertical ? texel.y : texel.x;
    int lineIndex = (int)(bVertical ? texel.x : texel.y);

    float4 self = LexUIPostProcessMainTexUB._MainTex.Sample(LexUIPostProcessMainTexUB._MainTexSampler, input.uv);
    float selfKey = ComputeKey(self);

    // A wall stays exactly where it is, and its own index is its destination.
    if (!IsSortable(selfKey, (int)index, lineIndex))
    {
        return float4(index, 0, 0, 1);
    }

    int radius = max((int)_SearchRadius, 1);
    float head = index;
    float tail = index;
    float rank = 0.0;

    // Backward to the run's head, counting everything that belongs before this texel.
    float probe = index;
    [loop]
    for (int i = 0; i < radius; i++)
    {
        probe -= 1.0;
        if (probe < 0.0) { head = probe + 1.0; break; }
        float v = ComputeKey(SampleAt(input.uv, probe, bVertical));
        if (!IsSortable(v, (int)probe, lineIndex)) { head = probe + 1.0; break; }
        // NOTE the asymmetry against the forward loop below: <= here, < there. That is what breaks
        // ties by position, so no two texels in a run can ever compute the same destination. Make
        // both sides the same operator and equal-valued texels collide -- one destination is claimed
        // twice and another never at all, which on flat colour is most of the image.
        if (v <= selfKey) { rank += 1.0; }
        head = probe;
    }

    // Forward to the run's tail. Only the head and the rank are needed for an ascending sort, but
    // the tail is what a descending one measures from.
    probe = index;
    [loop]
    for (int i = 0; i < radius; i++)
    {
        probe += 1.0;
        if (probe > lineLength - 1.0) { tail = probe - 1.0; break; }
        float v = ComputeKey(SampleAt(input.uv, probe, bVertical));
        if (!IsSortable(v, (int)probe, lineIndex)) { tail = probe - 1.0; break; }
        if (v < selfKey) { rank += 1.0; }
        tail = probe;
    }

    float destination = _Descending > 0.5 ? (tail - rank) : (head + rank);
    return float4(destination, 0, 0, 1);
}

// ------------------------------------------------------------------------------------------------
// Pass 2 -- who comes here?
// ------------------------------------------------------------------------------------------------
Texture2D _DestinationTex;
SamplerState _DestinationTexSampler;

float4 GatherPS(SimpleVSToPS input) : SV_Target0
{
    bool bVertical = _SortAxis > 0.5;
    float lineLength = bVertical ? _RegionSize.y : _RegionSize.x;
    float2 texel = floor(input.uv * _RegionSize);
    float index = bVertical ? texel.y : texel.x;

    // Pass 1 said where everyone is going; this inverts it, because a pixel shader can only gather.
    // Searching outward from this position finds the nearest claimant first, and a texel can only
    // have travelled as far as the radius allowed, so the search is bounded by the same number.
    int radius = max((int)_SearchRadius, 1);
    [loop]
    for (int i = 0; i <= radius; i++)
    {
        [unroll]
        for (int side = 0; side < 2; side++)
        {
            float probe = side == 0 ? index + (float)i : index - (float)i;
            if (probe < 0.0 || probe > lineLength - 1.0) { continue; }
            float2 target = bVertical ? float2(texel.x, probe) : float2(probe, texel.y);
            float2 targetUV = (target + 0.5) / _RegionSize;
            float destination = _DestinationTex.SampleLevel(_DestinationTexSampler, targetUV, 0.0).x;
            if (abs(destination - index) < 0.5)
            {
                return LexUIPostProcessMainTexUB._MainTex.SampleLevel(
                    LexUIPostProcessMainTexUB._MainTexSampler, targetUV, 0.0);
            }
            if (i == 0) { break; }//both sides are the same texel at distance zero
        }
    }

    // Nobody claimed this position. With an exact rank that cannot happen inside a run, but a
    // truncated search radius can leave a gap -- so keep what was already here rather than
    // punching a hole. mizt returns magenta here, which is right for a debug shader and wrong for
    // something an author will put over their UI.
    return LexUIPostProcessMainTexUB._MainTex.Sample(LexUIPostProcessMainTexUB._MainTexSampler, input.uv);
}
