#include "DreamUIRenderMeshVertexShader.usf"
#include "../DreamUIClip.ush"

Texture2D MainTex;
SamplerState MainTexSampler;
float4 TintColor;
int TintMode;
Texture2D ClipDataTex;

#if LEXUI_BLEND_DEPTH
Texture2D SceneDepthTex;
SamplerState SceneDepthTexSampler;
float4 SceneDepthTextureScaleOffset;
float SceneDepthBlend;
#if LEXUI_DEPTH_FADE
int SceneDepthFade;
float2 ViewSizeInv;
#endif
#endif

#if LEXUI_MASK
Texture2D MaskTex;
SamplerState MaskTexSampler;
#endif

void RenderMeshPS(
    RenderMeshVSToPS input,
    out float4 OutColor : SV_Target0
)
{
    OutColor = MainTex.Sample(MainTexSampler, input.uv);
    // Tint the captured background. Alpha is left alone here — clip, mask and depth blend below own it.
    // Strength 0 is a no-op in every mode, so the default (Multiply, white) leaves the source untouched.
    if (TintMode == 1)// Blend
    {
        OutColor.rgb = lerp(OutColor.rgb, TintColor.rgb, TintColor.a);
    }
    else if (TintMode == 2)// Additive
    {
        OutColor.rgb += TintColor.rgb * TintColor.a;
    }
    else// Multiply
    {
        OutColor.rgb *= lerp(float3(1, 1, 1), TintColor.rgb, TintColor.a);
    }
#if LEXUI_MASK
    OutColor.a *= MaskTex.Sample(MaskTexSampler, input.uv).r;
#endif
	OutColor.a *= DreamUI_CalculateClipData(ClipDataTex, input.uv1.x, input.localPosition);
#if LEXUI_BLEND_DEPTH
    float PixelDepth = input.screenPosition.z / input.screenPosition.w;
	float2 ScreenUV = input.screenPosition.xy / input.screenPosition.w;
	ScreenUV = ScreenUV * 0.5f + float2(0.5f, 0.5f);
	ScreenUV.y = 1.0f - ScreenUV.y;
#if LEXUI_DEPTH_FADE
	float DepthFadeValue = 0;
	int SampleCount = 0;
	int SampleSize = SceneDepthFade;
	ScreenUV = ScreenUV * SceneDepthTextureScaleOffset.xy + SceneDepthTextureScaleOffset.zw;
	for (int w = -SampleSize; w <= SampleSize; w++)
	{
		for (int h = -SampleSize; h <= SampleSize; h++)
		{
			float ExistDepth = SceneDepthTex.Sample(SceneDepthTexSampler, ScreenUV + float2(w, h) * ViewSizeInv.xy).x;
			DepthFadeValue += step(ExistDepth, PixelDepth);
			SampleCount++;
		}
	}
	DepthFadeValue /= SampleCount;
	DepthFadeValue = smoothstep(0, 1, DepthFadeValue);
#else
    float ExistDepth = SceneDepthTex.Sample(SceneDepthTexSampler, ScreenUV * SceneDepthTextureScaleOffset.xy + SceneDepthTextureScaleOffset.zw).x;
	float DepthFadeValue = step(ExistDepth, PixelDepth);
#endif
	OutColor.a = lerp(SceneDepthBlend * OutColor.a, OutColor.a, DepthFadeValue);
#endif
}
