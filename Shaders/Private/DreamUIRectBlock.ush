// A rect block's shape, from its row of rect block data (UDreamRectBlock::FillData). Included by the rect block
// material's Custom node (MF_DreamUI_RectBlock), and by the built-in UI shader through DreamUIShade.ush, which draws
// a rect block with whatever else its canvas batches it with (UDreamRectBlock::IsDrawnByBuiltInShader).
//
// Its body's and its border's gradients are gradient rows of the world's paint rows (FDreamGradient, as a text paints with),
// evaluated by DreamUIPaint.ush across the rect: UV0 is (0, 0) at its top left and (1, 1) at its bottom right.
#ifndef DREAMUI_RECT_BLOCK_USH
#define DREAMUI_RECT_BLOCK_USH
#include "/Engine/Private/GammaCorrectionCommon.ush"
#include "/Engine/Public/Platform.ush"
#include "/Plugin/DreamGUI/Private/DreamUIPaint.ush"

// How the body texture is sampled: Common.ush's Texture2DSample in a material, and whatever the built-in shader, which
// has no Common.ush, says before it includes this.
#ifndef DREAMUI_RECT_BLOCK_SAMPLE
#define DREAMUI_RECT_BLOCK_SAMPLE Texture2DSample
#endif

#ifndef PI
#define PI 3.14159265359f
#endif

#ifndef INV_PI
#define INV_PI 0.31830988618379f
#endif

#ifndef HALF_PI
#define HALF_PI 1.57079632679f
#endif

#ifndef INV_255
#define INV_255 0.00392156862745f
#endif

#ifndef INV_360
#define INV_360 0.00277777777777f
#endif

// ARGB. Alpha is in the top byte so that the word, which travels here as the bit pattern of a float
// in the data texture, is a normal float rather than a denormal: with red on top an opaque black is
// 0x000000ff, and a GPU that flushes denormals to zero (most mobile ones) reads that back as a fully
// transparent pixel. UDreamRectBlock::FillColorToData packs in this order; the two must ship together.
HALF4_TYPE DreamUI_UnpackUintColor(uint colorUint)
{
    HALF4_TYPE ResultColor;
    ResultColor.a = ((colorUint >> 24) & 0x000000ff) * INV_255;
    ResultColor.r = ((colorUint >> 16) & 0x000000ff) * INV_255;
    ResultColor.g = ((colorUint >> 8) & 0x000000ff) * INV_255;
    ResultColor.b = ((colorUint >> 0) & 0x000000ff) * INV_255;
    return ResultColor;
}
HALF4_TYPE DreamUI_ReadColor(float Data)
{
    uint ColorUint = asuint(Data);
    HALF4_TYPE Color = DreamUI_UnpackUintColor(ColorUint);
    Color.rgb = sRGBToLinear(Color.rgb);
    return Color;
}

// reference from https://www.shadertoy.com/view/4tGGRm
float DreamUI_sdRoundRect(float2 p, float2 b, float4 r)
{
    r.xyzw = min(r.xyzw, min(b.x, b.y));
    r.xy = (p.x > 0.0) ? r.xy : r.wz;
    r.x = (p.y > 0.0) ? r.x : r.y;
    float2 q = abs(p) - b + r.x;
    float d = min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r.x;
    return d;
}
/** Where a rect block's row of rect block data has its layer style's record (UDreamRectBlock::OwnDataTexels). */
#define DREAMUI_RECT_BLOCK_STYLE_FIRST 12

/**
 * The shape a layer style drawn in a rect block's pixels is measured round: its rounded rect, ShapeA.xy its half size and
 * ShapeB its corners' radii, P in units from its centre as sdFragCoord is.
 */
// A shape blend group's melted shape (UDreamShapeBlendGroup), drawn by its leader: in a row of the same rect block data.
#define DREAMUI_SHAPE_BLEND_PARAMS , Texture2D ShapeRows, int ShapeRow
#define DREAMUI_SHAPE_BLEND_ROW(Index) ShapeRows.Load(int3((Index), ShapeRow, 0))
#include "/Plugin/DreamGUI/Private/DreamUIShapeBlend.ush"

/** Or a shape blend group's melted shape, when ShapeA.z says so: ShapeA.w its row. */
float DreamUIRectBlock_StyleDistance(float2 P, float4 ShapeA, float4 ShapeB, Texture2D Rec)
{
    if (ShapeA.z > 0.5f)
    {
        float4 Unused;
        return DreamUIShapeBlend_Distance(P, Unused, Rec, (int)round(ShapeA.w));
    }
    return DreamUI_sdRoundRect(P, ShapeA.xy, ShapeB);
}
#define DREAMUI_STYLE_DISTANCE(P) DreamUIRectBlock_StyleDistance((P), ShapeA, ShapeB, Rec)
#include "/Plugin/DreamGUI/Private/DreamUILayerStyle.ush"

float DreamUI_sdRoundRectInnerShadow(float2 p, float2 b, float4 r, float shadowSize)
{
    r.xyzw = min(r.xyzw, min(b.x, b.y));
    r.xy = (p.x > 0.0) ? r.xy : r.wz;
    r.x = (p.y > 0.0) ? r.x : r.y;
    float2 q = abs(p) - b + r.x;
    float d = min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r.x;

    d = saturate((0.0 - d) / shadowSize);
    d = 1 - d;
    d = smoothstep(0, 1, d);
    return d;
}
float DreamUI_sdRoundRectOuterShadow(float2 p, float2 b, float4 r, float shadowSize)
{
    r.xyzw = min(r.xyzw, min(b.x, b.y));
    r.xy = (p.x > 0.0) ? r.xy : r.wz;
    r.x = (p.y > 0.0) ? r.x : r.y;
    float2 q = abs(p) - b + r.x;
    float d = min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r.x;

    d /= shadowSize;
    d = saturate(1.0 - d);
    d = smoothstep(0, 1, d);
    return d;
}

/**
 * What a gradient row (a rect block's body's or border's) paints at UV0 across a quad QuadSize big: straight, linear light.
 * InFallback where there is no row (below 0), no paint rows to read (bPaints false), or the row paints nothing.
 */
float4 DreamUIRectBlock_Gradient(Texture2D PaintDataTex, bool bPaints, float Row, float2 UV0, float2 QuadSize, float4 InFallback)
{
    float4 Painted = InFallback;
    if (bPaints && Row > -0.5f)
    {
        const float Aspect = QuadSize.y > 0.0f ? QuadSize.x / QuadSize.y : 1.0f;
        float4 Gradient;
        if (DreamUIPaint_Evaluate(PaintDataTex, Row, UV0, Aspect, 0.0f, 0.0f, float2(0.0f, 0.0f), 1.0f, Gradient))
        {
            Painted = Gradient;
        }
    }
    return Painted;
}

/**
 * Nine-slice along one axis: the two caps keep their own size and only what is between them stretches.
 *
 * InUV is the quad's own 0..1 across this axis. InLowUV / InHighUV are how much of the TEXTURE each
 * cap is; InLowPx / InHighPx are how much of the QUAD it occupies. Both are needed and neither can be
 * derived from the other here -- that would take the texture's dimensions, which is a fetch this
 * function does not otherwise need and the C++ side already knows.
 *
 * The caps are clamped against the quad on the C++ side, so InLowPx + InHighPx <= InQuadPx and the
 * middle span below is never negative. The max() is a guard for the exactly-equal case, where a rect
 * squeezed to precisely its two margins has no middle at all.
 */
float DreamUI_NineSliceAxis(float InUV, float InLowUV, float InHighUV, float InLowPx, float InHighPx, float InQuadPx)
{
    float Pos = InUV * InQuadPx;
    if (Pos < InLowPx)
    {
        // The leading cap, 1:1 with the texture -- an eight-pixel border stays eight pixels.
        return InLowUV * (Pos / max(InLowPx, 1e-4f));
    }
    if (Pos > InQuadPx - InHighPx)
    {
        return 1.0f - InHighUV * ((InQuadPx - Pos) / max(InHighPx, 1e-4f));
    }
    float MiddleT = (Pos - InLowPx) / max(InQuadPx - InLowPx - InHighPx, 1e-4f);
    return InLowUV + MiddleT * (1.0f - InLowUV - InHighUV);
}

/**
 * The rect block at this pixel, its row of rect block data in DataTex at UV3.x. Its gradients are read from PaintDataTex, the
 * world's paint rows, with bPaints; without, they draw as their body's and their border's plain colours.
 */
float DreamUI_CalculateRectBlockWith(Texture2D MainTex, SamplerState MainTexSampler, float2 UV0, float2 UV2, float2 UV3, Texture2D DataTex,
    Texture2D PaintDataTex, bool bPaints, inout float3 Color, inout float Alpha)
{
    half _TextureScaleMode;
    half _TextureDrawMode;
    float4 _SliceMarginUV;
    float4 _SliceMarginPx;
    float4 _CornerRadius;
    float2 _QuadSize;

    half _EnableBody;
    HALF4_TYPE _BodyColor;
    float2 _TextureUVCenter;
    half _EnableGradient;
    float _BodyGradientRow;

    half _EnableBorder;
    float _BorderWidth;
    half _EnableBorderGradient;
    HALF4_TYPE _BorderColor;
    float _BorderGradientRow;

    half _EnableInnerShadow;
    HALF4_TYPE _InnerShadowColor;
    float _InnerShadowSize;
    float _InnerShadowBlur;
    float2 _InnerShadowOffset;

    half _EnableOuterShadow;
    HALF4_TYPE _OuterShadowColor;
    float _OuterShadowSize;
    float _OuterShadowBlur;
    float2 _OuterShadowOffset;

    half _EnableRadialFill;
    half _EnableStyle;
    float _ShapeRow;
    float2 _RadialFillCenter;
    float _RadialFillAngle;
    float _RadialFillRotation;
    
    //read data from texture
    {
        int Coordinate = round(UV3.x);
        int3 Position = int3(0, Coordinate, 0);

        float4 PixelData = DataTex.Load(Position);Position.x += 1;
        // The top byte is a constant written by UDreamRectBlock::Fill8BytesToData and is not read
        // here: it is there so this word is a normal float rather than a denormal, because the flags
        // used to occupy the float's exponent and a GPU that flushes denormals to zero (most mobile
        // ones) read every flag back as 0 -- an element that draws nothing. The three payload bytes
        // sit one byte lower than they used to; the shader and the C++ must ship together.
        uint ByteUint = asuint(PixelData.r);
        uint BoolValues = (ByteUint >> 16) & 0x000000ff;
        _TextureScaleMode = (ByteUint >> 8) & 0x000000ff;
        _TextureDrawMode = (ByteUint >> 0) & 0x000000ff;
        
        _EnableBody = (BoolValues >> 7) & 1;
        _EnableOuterShadow = (BoolValues >> 6) & 1;
        _EnableGradient = (BoolValues >> 5) & 1;
        _EnableBorder = (BoolValues >> 4) & 1;
        _EnableBorderGradient = (BoolValues >> 3) & 1;
        _EnableInnerShadow = (BoolValues >> 2) & 1;
        _EnableRadialFill = (BoolValues >> 1) & 1;
        _EnableStyle = BoolValues & 1;
        
        // A shape blend group's leader names the row of the shape it draws, plus one (UDreamRectBlock::FillData).
        _ShapeRow = PixelData.g;
        _QuadSize = PixelData.ba;

        PixelData = DataTex.Load(Position);Position.x += 1;
        _CornerRadius = PixelData;
        PixelData = DataTex.Load(Position);Position.x += 1;
        _BodyColor = DreamUI_ReadColor(PixelData.r);
        _TextureUVCenter = PixelData.gb;
        // The body's and the border's gradient rows in the paint rows, below 0 for none (UDreamRectBlock::FillData). Texel 3,
        // the first word of texel 4, texel 5 and the first word of texel 6 are spare.
        _BodyGradientRow = PixelData.a;
        Position.x += 1;
        PixelData = DataTex.Load(Position);Position.x += 1;
        _BorderWidth = PixelData.y;
        _BorderColor = DreamUI_ReadColor(PixelData.z);
        _BorderGradientRow = PixelData.w;
        Position.x += 1;
        PixelData = DataTex.Load(Position);Position.x += 1;

        _InnerShadowColor = DreamUI_ReadColor(PixelData.y);
        _InnerShadowSize = PixelData.z;
        _InnerShadowBlur = PixelData.w;
        PixelData = DataTex.Load(Position);Position.x += 1;
        _InnerShadowOffset = PixelData.xy;
        
        _RadialFillCenter = PixelData.zw;
        PixelData = DataTex.Load(Position);Position.x += 1;
        _RadialFillRotation = PixelData.x;
        _RadialFillAngle = PixelData.y;
        
        _OuterShadowColor = DreamUI_ReadColor(PixelData.z);
        _OuterShadowSize = PixelData.w;
        PixelData = DataTex.Load(Position);Position.x += 1;
        _OuterShadowBlur = PixelData.x;
        _OuterShadowOffset = PixelData.yz;

        // The nine-slice margins, LTRB, in the texture's space and then in the quad's.
        _SliceMarginUV.x = PixelData.w;
        PixelData = DataTex.Load(Position);Position.x += 1;
        _SliceMarginUV.yzw = PixelData.xyz;
        _SliceMarginPx.x = PixelData.w;
        PixelData = DataTex.Load(Position);Position.x += 1;
        _SliceMarginPx.yzw = PixelData.xyz;
    }
    
    
    _InnerShadowOffset.y = -_InnerShadowOffset.y;
    _OuterShadowOffset.y = -_OuterShadowOffset.y;
    _RadialFillCenter.y = _QuadSize.y - _RadialFillCenter.y;

    HALF4_TYPE color = HALF4_TYPE(0,0,0,0);

    float2 sdQuadSize = _QuadSize * 0.5f;
    float2 sdFragCoord = (UV0 * 2.0f - float2(1.0f, 1.0f)) * sdQuadSize;
    // A shape blend group's leader draws the group's melted shape in its members' colours, and none of its own effects: they
    // measure its own rect. A layer style on the group is drawn round the melted shape below.
    const bool bMelted = _ShapeRow > 0.5f;
    float dOuter;
    BRANCH
    if (bMelted)
    {
        float4 MeltedColor;
        dOuter = DreamUIShapeBlend_Distance(sdFragCoord, MeltedColor, DataTex, (int)round(_ShapeRow) - 1);
        _BodyColor = HALF4_TYPE(MeltedColor);
        _EnableGradient = 0;
        _EnableBorder = 0;
        _EnableInnerShadow = 0;
        _EnableOuterShadow = 0;
    }
    else
    {
        dOuter = DreamUI_sdRoundRect(sdFragCoord, sdQuadSize, _CornerRadius);
    }
    // Taken here, in uniform flow, and kept for the layer style below, which runs inside a branch.
    const float dOuterWidth = fwidth(dOuter);
    float dOuterSharp = dOuter / dOuterWidth;
    // COVERAGE IS CENTRED ON THE BOUNDARY: half a pixel of ramp inside, half outside. dOuterSharp is
    // the signed distance in pixels, negative inside, so a pixel sitting exactly on the edge is HALF
    // covered -- which saturate(0.5 - s) gives and saturate(-s) does not. The latter ramps over
    // [-1,0], putting the 50% point a full half pixel inside the shape, so everything drawn this way
    // came out fractionally small and fractionally dark along every edge.
    //
    // Slate spends the same half pixel the same way -- SlateElementPixelShader.usf's
    // GetFontSignedDistanceOpacity is saturate(ScreenSpaceDistance + 0.5), the sign flipped only
    // because its distance is positive inside.
    //
    // The outer half of the ramp needs somewhere to live, and bSoftEdge provides it by expanding the
    // quad one unit a side (DreamUIGeometry.cpp:263-269). One unit covers half a pixel of ramp until
    // the widget is minified past 2:1, beyond which the outer half clips against the geometry.
    float dOuter01 = saturate(0.5f - dOuterSharp);
    
    //inner body
    if (_EnableBody)
    {
        float2 stretchUV = UV2;
        float2 fitUV = UV2;
        float2 envelopUV = UV2;
        {
            float fitUVX = (UV2.x - _TextureUVCenter.x) * _QuadSize.x / _QuadSize.y + _TextureUVCenter.x;
            float fitUVY = (UV2.y - _TextureUVCenter.y) * _QuadSize.y / _QuadSize.x + _TextureUVCenter.y;
            half lerpAlpha = saturate(sign(_QuadSize.x - _QuadSize.y));
            fitUV = lerp(float2(UV2.x, fitUVY), float2(fitUVX, UV2.y), lerpAlpha);
            envelopUV = lerp(float2(fitUVX, UV2.y), float2(UV2.x, fitUVY), lerpAlpha);
        }
        
        float2 texUV = lerp(lerp(stretchUV, fitUV, _TextureScaleMode), envelopUV, max(0, _TextureScaleMode - 1));

        // Nine-slice, as a remap of the sample rather than as nine quads: this rect is ONE quad
        // whose whole silhouette -- the rounded corners, the border, both shadows -- is signed
        // distance work against it, and cutting it up would leave nine SDFs that each know only
        // their own ninth. Changing which texel a body pixel reads leaves every one of them alone.
        //
        // Off the STRETCH UV, not the fitted one: a nine-slice already answers "how does this
        // survive a different aspect ratio", and letting FitIn pre-squash the source first would be
        // two answers to one question.
        float SliceCentreFade = 1.0f;
        if (_TextureDrawMode > 0.5f)
        {
            texUV.x = DreamUI_NineSliceAxis(UV2.x, _SliceMarginUV.x, _SliceMarginUV.z,
                _SliceMarginPx.x, _SliceMarginPx.z, _QuadSize.x);
            texUV.y = DreamUI_NineSliceAxis(UV2.y, _SliceMarginUV.y, _SliceMarginUV.w,
                _SliceMarginPx.y, _SliceMarginPx.w, _QuadSize.y);

            // Border is Box without its middle -- a frame around whatever is behind it. Dropped by
            // alpha rather than by discard: this body sits under a border, an inner shadow and a
            // gradient that all still have to draw, and a discard would take them with it.
            if (_TextureDrawMode > 1.5f)
            {
                float2 QuadPos = UV2 * _QuadSize;
                float2 InsideLow = step(_SliceMarginPx.xy, QuadPos);
                float2 InsideHigh = step(QuadPos, _QuadSize - _SliceMarginPx.zw);
                SliceCentreFade = 1.0f - InsideLow.x * InsideLow.y * InsideHigh.x * InsideHigh.y;
            }
        }

        float4 MainTexColor = DREAMUI_RECT_BLOCK_SAMPLE(MainTex, MainTexSampler, texUV);
        // A melted shape reaches past the leader's own rect, where its UVs leave 0..1 and the texture's edge would fade it: it
        // is drawn in its members' colours alone.
        MainTexColor.a *= SliceCentreFade;
        MainTexColor = bMelted ? float4(1.0f, 1.0f, 1.0f, 1.0f) : MainTexColor;
        // The body's colour, or its gradient in place of it, times the texture.
        const float4 BodyFill = _EnableGradient > 0.5f
            ? DreamUIRectBlock_Gradient(PaintDataTex, bPaints, _BodyGradientRow, UV0, _QuadSize, float4(_BodyColor))
            : float4(_BodyColor);
        float4 bodyColor = MainTexColor * BodyFill;
        bodyColor.rgb *= bodyColor.a;

        bodyColor.a *= dOuter01;
        bodyColor.rgb *= dOuter01;
        
        color = bodyColor;
    }
    
    if (_EnableInnerShadow)
    {
        float2 quadSize = sdQuadSize - _InnerShadowSize + _InnerShadowBlur * 0.5f;
        float4 cornerRadius = _CornerRadius + _InnerShadowBlur * 0.5f - _InnerShadowSize;
        cornerRadius = max(cornerRadius, _InnerShadowBlur);
        float sdInnerShadow = DreamUI_sdRoundRectInnerShadow(sdFragCoord - _InnerShadowOffset.xy, quadSize, cornerRadius, _InnerShadowBlur);
        sdInnerShadow = pow(sdInnerShadow, 2.2);
        HALF4_TYPE innerShadowColor = _InnerShadowColor;
        innerShadowColor.a *= sdInnerShadow;
        innerShadowColor.rgb *= innerShadowColor.a;
        color = color * (1 - innerShadowColor.a) + innerShadowColor;
        color.a *= dOuter01;
        color.rgb *= dOuter01;
    }

    if (_EnableBorder * sign(abs(_BorderWidth)))
    {
        // The border's colour, or its gradient in place of it.
        float4 borderColor = _EnableBorderGradient > 0.5f
            ? DreamUIRectBlock_Gradient(PaintDataTex, bPaints, _BorderGradientRow, UV0, _QuadSize, float4(_BorderColor))
            : float4(_BorderColor);
        borderColor.rgb *= borderColor.a;
        float dInner = DreamUI_sdRoundRect(sdFragCoord, sdQuadSize - _BorderWidth, _CornerRadius - _BorderWidth);
        float dInnerSharp = dInner / fwidth(dInner);
        // Centred, as above. This boundary is interior -- the border ring surrounds it -- so unlike
        // the outer edge it never needed a skirt to ramp into.
        float dInner01 = saturate(0.5f - dInnerSharp);
        float innerMask = saturate(1 - dInner01);
        borderColor.a *= innerMask;
        borderColor.rgb *= innerMask;
        
        color = color * (1 - borderColor.a) + borderColor;
        color.a *= dOuter01;
        color.rgb *= dOuter01;
    }

    // A layer style (UDreamLayerStyle) round the rect's shape, over what is drawn so far: in encoded values, as an image editor
    // blends, and back. Its record follows this block's own texels in the row. The rect block's own outer shadow stays under it.
    BRANCH
    if (_EnableStyle > 0.5f)
    {
        const float AA = max(dOuterWidth, 1e-4f);
        const float3 Straight = color.a > 0.0f ? color.rgb / color.a : float3(0.0f, 0.0f, 0.0f);
        const float Opacity = dOuter01 > 0.0f ? saturate(color.a / dOuter01) : 0.0f;
        const int2 StyleAt = int2(DREAMUI_RECT_BLOCK_STYLE_FIRST, (int)round(UV3.x));
        FDreamUIStyleShaded Styled = DreamUIStyle_Shade(DataTex, StyleAt, sdFragCoord, sdQuadSize, AA,
            DreamUIBlend_ToSrgb(saturate(Straight)), Opacity, dOuter01, int2(floor(sdFragCoord / AA)),
            float4(sdQuadSize, bMelted ? 1.0f : 0.0f, round(_ShapeRow) - 1.0f), _CornerRadius);
        const float StyledAlpha = saturate(Styled.Flat.a);
        const float3 StyledStraight = StyledAlpha > 0.0f ? Styled.Flat.rgb / StyledAlpha : float3(0.0f, 0.0f, 0.0f);
        color = HALF4_TYPE(DreamUIBlend_ToLinear(saturate(StyledStraight)) * StyledAlpha, StyledAlpha);
    }

    //outer shadow
    if (_EnableOuterShadow)
    {
        HALF4_TYPE outerShadowColor = _OuterShadowColor;
        float4 cornerRadius = _CornerRadius + _OuterShadowSize;
        float sdOuterShadow = DreamUI_sdRoundRectOuterShadow(sdFragCoord - _OuterShadowOffset, sdQuadSize + _OuterShadowSize, cornerRadius, _OuterShadowBlur * 0.5f);
        sdOuterShadow = pow(sdOuterShadow, 2.2);
        outerShadowColor.a *= sdOuterShadow;
        float outerMask = 1.0f - dOuter01;
        half bodyVisible = sign(_EnableBody + _EnableBorder + _EnableInnerShadow); //is body visible?
        outerShadowColor.a *= lerp(
        outerMask // if body not visible, make it smooth
        , sign(outerMask) //if body is visible, make it no smooth, because smooth can show a thin transparent line between body and outshadow
        , bodyVisible);
        outerShadowColor.rgb *= outerShadowColor.a;
        color = outerShadowColor * (1.0 - color.a) + color;
    }

    if (_EnableRadialFill * sign(max(0, 360.0f - _RadialFillAngle)))
    {
        float2 fragCoord = UV0 * _QuadSize;
        float2 centerToPixelDiff = fragCoord - _RadialFillCenter;
        float2 centerToPixelVector = normalize(centerToPixelDiff);

        float rotation = radians(_RadialFillRotation + _RadialFillAngle * 0.5f + 180.0f);
        float cosAngle = cos(rotation);
        float sinAngle = sin(rotation);
        float2x2 rotationMatrix = float2x2(cosAngle, sinAngle, -sinAngle, cosAngle);
        centerToPixelVector = mul(rotationMatrix, centerToPixelVector);
        float angle = atan2(centerToPixelVector.y, centerToPixelVector.x);
        float radialFillMask = abs(angle * INV_PI);
        radialFillMask += _RadialFillAngle * INV_360 - 1.0f;
                    
        radialFillMask /= fwidth(radialFillMask);
        // Centred, as above -- but NOTE THE SIGN IS THE OTHER WAY ROUND HERE. This mask is positive
        // INSIDE the wedge, where the two SDFs above are negative inside, so centring adds the half
        // pixel instead of subtracting it. Copying the form from either of them would move this edge
        // a whole pixel the wrong way.
        radialFillMask = saturate(radialFillMask + 0.5f);
        
        color.a *= radialFillMask;
        color.rgb *= radialFillMask;
    }
    //color.a *= sign(abs(_QuadSize.x)) * sign(abs(_QuadSize.y));//if size is 0

    //we do PremultiplyAlpha for color blending inside RectBlock.
    //because AlphaComposite(PremultiplyAlpha) do "color.rgb * color.a" at last step (DreamUIShader.usf), so we invert that operation here "color.rgb / color.a".
    // color.a is exactly zero on every fully transparent pixel -- outside a rounded corner, outside
    // the radial fill wedge, anywhere on a zero-size quad -- and the divide there is 0/0. The NaN it
    // returns does not stay in this pixel: the AlphaComposite step multiplies it by the alpha again
    // (NaN * 0 is still NaN), and an MSAA resolve averages it across the sample block, which is the
    // black or white square that occasionally appears over a RectBlock.
    // The comparisons also launder a NaN that reached the alpha itself -- normalize() of a zero
    // vector when _RadialFillCenter sits exactly on the fragment, or a zero _QuadSize -- because
    // every comparison against a NaN is false, so it falls to the transparent branch.
    float unpremultiplyAlpha = (color.a > 0.0f) ? color.a : 0.0f;
    Color = (unpremultiplyAlpha > 0.0f) ? color.rgb / unpremultiplyAlpha : float3(0.0f, 0.0f, 0.0f);
    Alpha = unpremultiplyAlpha;

    return 1;
}

/** The rect block with its gradients from the world's paint rows: what MF_DreamUI_RectBlock calls. */
float DreamUI_CalculateRectBlock(Texture2D MainTex, SamplerState MainTexSampler, float2 UV0, float2 UV2, float2 UV3, Texture2D DataTex,
    Texture2D PaintDataTex, inout float3 Color, inout float Alpha)
{
    return DreamUI_CalculateRectBlockWith(MainTex, MainTexSampler, UV0, UV2, UV3, DataTex, PaintDataTex, true, Color, Alpha);
}

/**
 * The rect block as a material that calls this itself with the arguments it always passed draws it: no paint rows, so its
 * gradients are drawn as its body's and its border's plain colours. The data texture stands in for the paint rows, which
 * are never read then.
 */
float DreamUI_CalculateRectBlock(Texture2D MainTex, SamplerState MainTexSampler, float2 UV0, float2 UV2, float2 UV3, Texture2D DataTex, inout float3 Color, inout float Alpha)
{
    return DreamUI_CalculateRectBlockWith(MainTex, MainTexSampler, UV0, UV2, UV3, DataTex, DataTex, false, Color, Alpha);
}

#endif // DREAMUI_RECT_BLOCK_USH
