namespace UObjectToolTips

DreamUIStyleDialogBlending {
    at    Source/DreamGUIEditor/Public/Workflow/DreamUILayerStyleDialog.h#DreamUIStyleDialogBlending
    src   "The layer's own blending, on the style dialog's Blending Options page: its element's blend mode and its opacity. The page's\nother values -- the fill opacity, the scale of every size, the global light -- are the style's own."
    text  "图层自身的混合，位于样式对话框的“混合选项”页：其元素的混合模式和不透明度。该页的\n其他值——填充不透明度、每个尺寸的缩放、全局光——属于样式自身。"
    state machine
}

DreamUIStyleDialogBlending:BlendMode {
    at    Source/DreamGUIEditor/Public/Workflow/DreamUILayerStyleDialog.h#DreamUIStyleDialogBlending:BlendMode
    src   "The element's blend mode (its visual's BlendMode)."
    text  "元素的混合模式（其视觉的BlendMode）。"
    state machine
}

DreamUIStyleDialogBlending:Opacity {
    at    Source/DreamGUIEditor/Public/Workflow/DreamUILayerStyleDialog.h#DreamUIStyleDialogBlending:Opacity
    src   "The widget's opacity, its effects included (RenderOpacity)."
    text  "控件的不透明度，包含其效果（RenderOpacity）。"
    state machine
}

DreamUIStyleDialogModel {
    at    Source/DreamGUIEditor/Public/Workflow/DreamUILayerStyleDialog.h#DreamUIStyleDialogModel
    src   "What the style dialog edits, as the details view sees it: the working style and the layer's blending. The parameters are\nshown as fields of this -- an effect's angle is Style.DropShadows[1].Angle, as it is a layer style's in a widget's details\n-- so an editor that finds its way about the style from a field (a light angle that turns the style's global light) works\nhere as it does there."
    text  "样式对话框所编辑的内容，以细节视图所见的方式呈现：工作样式和图层的混合。这些参数\n作为此对象的字段显示——效果的角度是 Style.DropShadows[1].Angle，正如控件细节中图层样式的角度\n——因此，通过字段来定位样式的编辑器（例如旋转样式全局光的光照角度）在此处的\n工作方式与在那里相同。"
    state machine
}

EDreamUIStyleDialogPage {
    at    Source/DreamGUIEditor/Public/Workflow/DreamUILayerStyleDialog.h#EDreamUIStyleDialogPage
    src   "One row of the style dialog's list: Blending Options, an effect, or one sub-page of the bevel."
    text  "样式对话框列表中的一行：混合选项、某个效果，或斜面的某个子页。"
    state machine
}

