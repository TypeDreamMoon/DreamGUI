    src   "Set text value and NOT send callback event"
    text  "设置文本值但不发送回调事件"
    state machine
}

UITextInput:SetVirtualKeyboardOptions {
    at    Source/DreamGUIControls/Public/Interaction/UITextInput.h#UITextInput:SetVirtualKeyboardOptions
    src   "The correctly spelled name for SetVirtualKeyboradOptions, which stays as it is for callers.\nNot BlueprintCallable, and cannot be: FVirtualKeyboardOptions is a plain USTRUCT in Slate with\nno BlueprintType on it -- which is why the misspelled one was never a Blueprint node either."
    text  "SetVirtualKeyboradOptions 的正确拼写名称，为调用方仍保留原名。\n不是 BlueprintCallable，也不能是：FVirtualKeyboardOptions 是 Slate 中的普通 USTRUCT，\n没有 BlueprintType——这也是拼错的那个从来不是蓝图节点的原因。"
    state machine
}

UITextInput:ShowContextMenu {
    at    Source/DreamGUIControls/Public/Interaction/UITextInput.h#UITextInput:ShowContextMenu
    src   "Open the edit menu next to the last place the pointer touched this field (the field's own\ncentre when there was no pointer -- a gamepad or Shift+F10 opened it). Builds only the entries\nthat can act; with none of them applicable nothing opens."
    text  "在指针最后触及该字段的位置旁打开编辑菜单（没有指针时使用字段自身的\n中心——例如用手柄或 Shift+F10 打开）。只构建可执行的条目；\n若没有适用的条目则不会打开任何内容。"
    state machine
}

