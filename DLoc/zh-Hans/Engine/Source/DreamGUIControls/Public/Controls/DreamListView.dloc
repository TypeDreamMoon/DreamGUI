}

DreamListViewBase:WheelScrollMultiplier {
    at    Source/DreamGUIControls/Public/Controls/DreamListView.h#DreamListViewBase:WheelScrollMultiplier
    src   "How many ROWS a wheel notch travels. One is the only sensitivity a list can state without\nguessing -- it is the unit the content is made of -- and this is the multiplier on it, for a\nlong list where a row at a time is too slow. Zero stops the wheel."
    text  "滚轮每格滚动多少行。一是在无需猜测的情况下列表唯一能给出的灵敏度——它是内容构成的基本单位——\n而这是它的倍数，用于一次一行太慢的长列表。\n为零时滚轮停止滚动。"
    state machine
}

DreamListViewBase:WindowStart {
    at    Source/DreamGUIControls/Public/Controls/DreamListView.h#DreamListViewBase:WindowStart
    src   "The display index the realized window starts at. Zero while not recycling."
    text  "已实现窗口起始处的显示索引。未回收时为零。"
