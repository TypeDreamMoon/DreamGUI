namespace UObjectToolTips

DreamTextInput {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput
    src   "A text field whose hierarchy is code, not an asset.\n\nThe same four nodes both preset Blueprints carry -- a background, a placeholder, and a clip area\nholding the text -- and one property, bMultiLine, where the presets are two assets. The clip\narea is not decoration: a field's text is regularly wider than the field, and without a clip the\noverflow draws over whatever is beside it.\n\nUUITextInput does everything hard (caret, selection, IME, key routing); this class builds the\ngeometry it works in and hands it the parts."
    text  "一个层级由代码而非资产构建的文本字段。\n\n两个预设蓝图携带的同样四个节点——背景、占位符，以及容纳文本的裁剪区域——\n外加一个属性 bMultiLine，而预设是两个资产。裁剪区域\n并非装饰：字段的文本经常比字段本身宽，没有裁剪时，\n溢出部分会绘制到旁边的任何东西上。\n\nUUITextInput 负责所有困难的部分（光标、选择、IME、按键路由）；此类构建它\n运作的几何体，并把各部分交给它。"
    state machine
}

DreamTextInput:bAllowContextMenu {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bAllowContextMenu
    src   "The edit menu on right click / long press / the pad's Menu button. UMG's AllowContextMenu."
    text  "右键单击/长按/手柄 Menu 键时弹出的编辑菜单。对应 UMG 的 AllowContextMenu。"
    state machine
}

DreamTextInput:bAutoActivateInputWhenNavigateIn {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bAutoActivateInputWhenNavigateIn
    src   "Start editing as soon as the arrows or the pad land on the field. Tab starts it anyway while UDreamGUISettings::bTabStartsTextEdit."
    text  "方向键或手柄一旦落到该字段上就开始编辑。在 UDreamGUISettings::bTabStartsTextEdit 开启时，Tab 无论如何都会开始编辑。"
    state machine
}

DreamTextInput:bClearKeyboardFocusOnCommit {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bClearKeyboardFocusOnCommit
    src   "Stop editing once Enter commits -- UMG's ClearKeyboardFocusOnCommit.\n\nTRUE here where UMG's is false, because true is what this field has always done and a default\nthat changed existing screens' behaviour is not a default. Off keeps the keyboard for the next\nvalue."
    text  "回车提交后停止编辑——对应 UMG 的 ClearKeyboardFocusOnCommit。\n\n此处默认为 TRUE 而 UMG 中为 false，因为此字段一直是这么做的，而改变现有界面行为的默认值\n不能算默认值。关闭时保留键盘以便输入下一个\n值。"
    state machine
}

DreamTextInput:bIsCaretMovedWhenGainFocus {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bIsCaretMovedWhenGainFocus
    src   "Whether gaining the edit moves the caret to the end -- UMG's IsCaretMovedWhenGainFocus."
    text  "获得编辑时是否将光标移到末尾——对应 UMG 的 IsCaretMovedWhenGainFocus。"
    state machine
}

DreamTextInput:bMultiLine {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bMultiLine
    src   "One property where the presets are two assets."
    text  "一个属性，其预设为两个资产。"
    state machine
}

DreamTextInput:bReadOnly {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bReadOnly
    src   "Selectable and copyable, not editable. UMG's IsReadOnly."
    text  "可选择、可复制，但不可编辑。对应 UMG 的 IsReadOnly。"
    state machine
}

DreamTextInput:bRevertTextOnEscape {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bRevertTextOnEscape
    src   "Escape / Back throws the edit away instead of keeping it -- UMG's RevertTextOnEscape.\nThe text the edit began with is put back (OnTextChanged fires for it) and then committed once --\nOnTextCommitted and OnSubmitted carry the restored text, as UMG commits a revert -- and the edit\nends. An edit that changed nothing reverts and commits nothing.\nOff, as UMG's is and as this field behaved before the knob existed."
    text  "Escape / Back 会丢弃这次编辑而不是保留它——对应 UMG 的 RevertTextOnEscape。\n编辑开始时的文本会被还原（并为此触发 OnTextChanged），然后提交一次——\nOnTextCommitted 和 OnSubmitted 携带还原后的文本，正如 UMG 提交一次还原那样——随后编辑\n结束。没有产生任何更改的编辑会还原，且不提交任何内容。\n关闭时与 UMG 的默认一致，也与该字段在此开关存在之前的行为一致。"
    state machine
}

DreamTextInput:bSelectAllTextOnCommit {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bSelectAllTextOnCommit
    src   "Select the value after a commit that kept the edit going -- UMG's SelectAllTextOnCommit."
    text  "提交后若编辑仍继续，则选中该值——对应 UMG 的 SelectAllTextOnCommit。"
    state machine
}

DreamTextInput:bSelectAllWhenActivateInput {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bSelectAllWhenActivateInput
    src   "Select the whole value when the field starts being edited. UMG's SelectAllTextWhenFocused."
    text  "字段开始编辑时选中整个值。对应 UMG 的 SelectAllTextWhenFocused。"
    state machine
}

DreamTextInput:bSubmitWhenDeactivate {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bSubmitWhenDeactivate
    src   "Commit the value when the edit ends without an Enter -- clicking away, navigating away."
    text  "编辑在没有按 Enter 的情况下结束时提交该值——例如点击别处、导航离开。"
    state machine
}

DreamTextInput:bTabTypesTabCharacter {
    at    Source/DreamGUIControls/Public/Controls/DreamTextInput.h#DreamTextInput:bTabTypesTabCharacter
    src   "In multiline mode, Tab types a tab character and Ctrl+Tab leaves the field -- a notes or code box. Off, the\ndefault, Tab leaves as it does a single-line field: the edit ends and the next control takes the focus, as a\nbrowser's textarea does. See UUITextInput::bTabTypesTabCharacter."
    text  "在多行模式下，Tab 输入一个制表符，Ctrl+Tab 则离开该字段——适合备注或代码框。关闭（默认）时，Tab\n与单行字段一样离开：编辑结束，下一个控件获得焦点，正如浏览器的 textarea 那样。参见\nUUITextInput::bTabTypesTabCharacter。"
    state machine
}

