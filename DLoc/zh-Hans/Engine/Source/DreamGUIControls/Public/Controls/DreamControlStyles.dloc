namespace UObjectToolTips

DreamBorderStyle {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamBorderStyle
    src   "A border: a brush, a padding and one child.\n\nUMG's Border is a panel with a look, and this library already offers that shape as a PANEL entry\n(an overlay carrying an image). This is the CONTROL spelling of it -- the one that reads the\nproject sheet, so every bordered box in a project restyles at once -- and it is the reason a\ncontrol class exists beside the panel: a panel's brush is authored per instance, and a control's\nis authored once for the whole project."
    text  "边框：一个笔刷、一个填充和一个子项。\n\nUMG的Border是带外观的面板，本库已把这种形态作为PANEL条目\n（承载图像的叠加层）提供。这里给出的是它的CONTROL写法——读取\n项目样式表的那个，因此项目中每个带边框的方框都会一并重设样式——这也是\n面板之外还存在一个控件类的原因：面板的笔刷按实例编写，而控件的\n笔刷对整个项目只编写一次。"
    state machine
}

DreamBorderStyle:bOverride_BorderThickness {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamBorderStyle:bOverride_BorderThickness
    src   "The border's own line. Zero draws no outline, which is UMG's default border."
    text  "边框自身的线。为零则不绘制轮廓，这也是UMG的默认边框。"
    state machine
}

DreamBorderStyle:bOverride_Padding {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamBorderStyle:bOverride_Padding
    src   "Between the border's edge and whatever is inside it -- UMG's Padding."
    text  "位于边框边缘与其内部内容之间——即UMG的填充。"
    state machine
}

DreamButtonStyle {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle
    src   "A button: one face, three pointer states, a label.\n\nThe face colours are absolute -- the brush stays white and the selectable writes these onto it --\nrather than the gallery's habit of a coloured brush multiplied by near-white transition tints.\nAbsolute colours are the ones a style sheet can actually reason about; a product of two sources\nis a look nobody can name."
    text  "按钮：一个面、三种指针状态、一个标签。\n\n面的颜色是绝对值——笔刷保持白色，由可选择控件把这些颜色写上去——\n而不是示例库的惯常做法：用彩色笔刷乘以接近白色的过渡色。\n绝对颜色才是样式表真正能推演的颜色；两个来源相乘\n得到的外观，没人叫得出名字。"
    state machine
}

DreamButtonStyle:bOverride_ContentPadding {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle:bOverride_ContentPadding
    src   "Between the face's edge and what is in the hole -- UMG's ContentPadding, and half of the\nbutton's own size: the face is a size box, and this is the padding it measures with."
    text  "位于面的边缘与孔洞中的内容之间——即UMG的ContentPadding，也是\n按钮自身尺寸的一半：面是一个尺寸框，而这就是它用来度量的填充。"
    state machine
}

DreamButtonStyle:bOverride_CornerRadius {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle:bOverride_CornerRadius
    src   "No LabelColor and no FontSize. A button draws no text of its own -- what is on one is whatever\nthe host puts in its hole -- so a text look here would be a knob with nothing to write it onto,\nwhich is worse than no knob at all: it reads as \"this is how my button's label looks\" and does\nnothing. Whoever supplies the label styles it, and where that is a control rather than an\nauthor, that control's own style says so (FDreamDialogStyle::ButtonLabelColor)."
    text  "没有 LabelColor，也没有 FontSize（字体大小）。按钮自身不绘制文本——按钮上显示的内容是\n宿主放进其孔洞里的东西——所以在这里做文本外观，会是一个无处可写的调节项，\n比完全没有调节项更糟：它读起来像是“我的按钮标签就是这样”，却什么\n都不做。谁提供标签，就由谁为其设置样式；如果提供者是控件而不是\n作者，那么该控件自身的样式会说明这一点（FDreamDialogStyle::ButtonLabelColor）。"
    state machine
}

DreamButtonStyle:bOverride_Disabled {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle:bOverride_Disabled
    src   "Not interactable. Every control pushed three pointer colours and left this one to the\nbehaviour's library default, a flat grey that belongs to no theme -- so a disabled control was\nthe one state a project sheet could not describe."
    text  "不可交互。每个控件都推送了三种指针颜色，却把这一种留给\n行为库的默认值——一种不属于任何主题的纯灰色——所以禁用状态的控件\n曾是项目样式表唯一无法描述的状态。"
    state machine
}

DreamButtonStyle:bOverride_Focused {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle:bOverride_Focused
    src   "Focused by keyboard or gamepad, which is a different question from hovered: focus survives the\npointer moving away, and on a pad there is no pointer at all. Pushing a colour here is what\nturns the selectable's focus visuals on -- they ship off, so before this a pad user saw the\nnavigation land on nothing."
    text  "由键盘或手柄获得焦点，这与悬停是两回事：指针移开后\n焦点依然存在，而在手柄上根本没有指针。在这里推送颜色，才会\n开启可选择控件的焦点视觉效果——它们默认是关闭的，所以在此之前手柄用户看到的\n导航会落在空处。"
    state machine
}

DreamButtonStyle:bOverride_Height {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle:bOverride_Height
    src   "The button's minimum height, not its height: a row of buttons lines up at this number, and one\nholding something taller than it grows instead of clipping. It reaches the control as the size\nbox's MinDesiredSize; see UDreamButton."
    text  "按钮的最小高度，而不是它的高度：一排按钮按这个数值对齐，而\n放置了更高内容的按钮会随之增高而不是被裁剪。该值以尺寸框的\nMinDesiredSize传给控件；参见UDreamButton。"
    state machine
}

DreamButtonStyle:bOverride_StateFaces {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle:bOverride_StateFaces
    src   "A different drawing per state, where FaceBrush is one drawing tinted five ways. Empty\nthroughout, which is what keeps every existing button pixel-identical; FaceBrush is what an\nunstated state falls back to. ContentPadding is the resting padding its PressedPadding\nalternates with."
    text  "每个状态一份不同的绘制，其中 FaceBrush（笔刷）是一份按五种方式着色的绘制。全部\n为空，这正是让每个现有按钮保持像素一致的原因；FaceBrush 是未声明的\n状态的回落对象。ContentPadding 是静止状态的填充，其 PressedPadding\n与之交替。"
    state machine
}

DreamButtonStyle:bOverride_TransitionDuration {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamButtonStyle:bOverride_TransitionDuration
    src   "How long a state change takes, in seconds. Zero snaps."
    text  "状态变化所需的时间，单位为秒。零表示瞬间切换。"
    state machine
}

DreamDialogStyle {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamDialogStyle
    src   "A dialog: a dimmer over the screen, a panel on it, a title, content and buttons."
    text  "对话框：屏幕上的一层遮罩，其上有一个面板，以及标题、内容和按钮。"
    state machine
}

DreamDialogStyle:bOverride_Button {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamDialogStyle:bOverride_Button
    src   "The buttons are Native.Button instances; this is the style they wear."
    text  "这些按钮是 Native.Button 实例；这是它们使用的样式。"
    state machine
}

DreamDialogStyle:bOverride_ButtonLabelColor {
    at    Source/DreamGUIControls/Public/Controls/DreamControlStyles.h#DreamDialogStyle:bOverride_ButtonLabelColor
    src   "The wording on those buttons -- which is the DIALOG's to describe, because the dialog is what\nputs it there.\n\nA button draws no text of its own; UDreamDialog builds one UDreamText per entry in Buttons and\nhangs it in that button's content hole, exactly as a .dui author would nest one. These two are\nthat text's look, and they sit beside TitleColor/MessageColor for the same reason: every other\nstring this dialog draws is described right here.\n\nOne pair, not one per button kind. Plain and primary differ in their FACE (two whole button\nstyles above); nothing has yet wanted them to differ in their lettering, and a second pair can\nbe added the day something does."
    text  "那些按钮上的文字——由对话框来描述，因为把它放上去的正是\n对话框。\n\n按钮自身不绘制文本；UDreamDialog 会为 Buttons 中的每一项构建一个 UDreamText，\n并将它挂在对应按钮的内容孔中，与 .dui 作者嵌套一个文本完全一样。这两项\n就是该文本的外观，它们与 TitleColor/MessageColor 并列，原因相同：这个对话框绘制的\n其他每个字符串都在这里描述。\n\n只有一对，而不是每种按钮各一对。普通按钮与主要按钮的差别在它们的 FACE（上面两整套按钮\n样式）；目前还没有什么需要它们在字形上有所不同，等到需要时再加一对\n即可。"
    state machine
}

