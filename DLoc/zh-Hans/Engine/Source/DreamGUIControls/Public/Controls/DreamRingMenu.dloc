DreamRingMenu:SetLabelFacing {
    at    Source/DreamGUIControls/Public/Controls/DreamRingMenu.h#DreamRingMenu:SetLabelFacing
    src   "Re-orients every wedge's label, which is geometry the style push writes."
    text  "重新调整每个扇区标签的朝向，这是样式推送所写入的几何信息。"
    state machine
}

DreamRingMenu:SetSelectedIndex {
