namespace UObjectToolTips

DreamPath {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath
    src   "A path drawn as a line: points that can be moved in the designer, joined straight or by a smooth curve, open or closed.\nIt is drawn with the line renderer's brush and width; with Draw Line off it draws nothing and is only a path, for text\nto run along (UDreamMeshModifierTextOnPath) or for anything else to measure (GetPointAtDistance)."
    text  "一条用直线绘制的路径：可以在设计器中移动的点，可以直线连接或通过平滑曲线连接，可以是开放的或闭合的。\n它使用线渲染器的笔刷和宽度进行绘制；如果禁用“绘制线条”，则不会绘制线条，而只是一个路径，用于文本\n（UDreamMeshModifierTextOnPath）或用于测量其他对象（GetPointAtDistance）。"
    state machine
}

DreamPath:bClosed {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath:bClosed
    src   "The last point joins the first. The line then joins its ends too."
    text  "最后一点连接到第一点。然后，线条连接其两端。"
    state machine
}

DreamPath:bDrawLine {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath:bDrawLine
    src   "Draws the line; off, the path is there to be followed and nothing is drawn."
    text  "绘制线条；禁用时，路径仅用于跟踪，不绘制任何内容。"
    state machine
}

DreamPath:GetLength {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath:GetLength
    src   "The path's length in local units."
    text  "路径的长度，以本地单位为单位。"
    state machine
}

DreamPath:GetPointAtDistance {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath:GetPointAtDistance
    src   "The point InDistance along the path, in local space, and the direction it runs there."
    text  "路径上距离 InDistance 处的一点，以本地坐标系表示，以及其运行方向。"
    state machine
}

DreamPath:Points {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath:Points
    src   "The points the path runs through, in the widget's local space."
    text  "路径上的一点，以本地坐标系表示；超出末尾的点将被忽略。"
    state machine
}

DreamPath:SegmentsPerSpan {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath:SegmentsPerSpan
    src   "Straight pieces between two points of a smooth path."
    text  "路径通过其点的直线段。"
    state machine
}

DreamPath:SetPoint {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamPath.h#DreamPath:SetPoint
