EDreamPixelSortKey {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamPixelSort.h#EDreamPixelSortKey
    src   "What decides a pixel's place in the sort, and which pixels take part."
    text  "决定像素在排序中的位置，以及哪些像素参与排序。"
    state machine
}

EDreamPixelSortKey.Alpha {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamPixelSort.h#EDreamPixelSortKey:Alpha
    src   "Alpha. Note that on a 10-bit backbuffer alpha carries two bits, so this collapses to four\nvalues and the sort becomes close to a no-op -- it is only useful on an 8-bit or float target."
    text  "Alpha。注意在 10 位后台缓冲区上 alpha 只占两位，因此会退化为四个\n值，排序几乎不起作用——它只在 8 位或浮点目标上有用。"
    state machine
}

EDreamPixelSortKey.Brightness {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamPixelSort.h#EDreamPixelSortKey:Brightness
    src   "Largest of R/G/B. Picks out highlights harder than luminance does."
    text  "R/G/B 中的最大值。比亮度更能突出高光。"
    state machine
}

EDreamPixelSortKey.Hue {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamPixelSort.h#EDreamPixelSortKey:Hue
    src   "Hue, 0..1 around the wheel. Sorts by colour rather than by tone, which gives the rainbow\nbanding the effect is known for. Note it WRAPS: red is at both ends, so a run spanning red\nsplits rather than sorting smoothly. That is inherent to sorting an angle, not a defect."
    text  "色相，在色轮上取 0..1。按颜色而不是按明暗排序，这正是该效果著称的彩虹\n条带的来源。注意它是环绕的：红色位于两端，因此跨越红色的区段会分裂，\n而不能平滑排序。这是按角度排序的固有特性，并非缺陷。"
    state machine
}

EDreamPixelSortKey.Intensity {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamPixelSort.h#EDreamPixelSortKey:Intensity
    src   "R+G+B over three. Flatter than luminance -- it does not privilege green."
    text  "R+G+B 除以三。比亮度更平缓——它不会偏向绿色。"
    state machine
}

EDreamPixelSortKey.Luminance {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamPixelSort.h#EDreamPixelSortKey:Luminance
    src   "Rec.709 luminance. The usual choice, and the one the threshold defaults are tuned for."
    text  "Rec.709 亮度。最常用的选择，也是阈值默认值所针对调校的对象。"
    state machine
}

