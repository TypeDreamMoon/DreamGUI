namespace UObjectToolTips

DreamBackgroundPixelate {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamBackgroundPixelate.h#DreamBackgroundPixelate
    src   "UI element that can make the background look pixelated\nUse it in ScreenSpace or WorldSpace-DreamUIRenderer.\nIf android OpenGL ES3.1, need to enable \"ProjectSettings/Platforms/Android/Build/Support Backbuffer Sampling on OpenGL\"."
    text  "可使背景呈现像素化效果的 UI 元素。\n请在 ScreenSpace 或 WorldSpace-DreamUIRenderer 中使用。\n如果为 Android OpenGL ES3.1，则需要启用“ProjectSettings/Platforms/Android/Build/Support Backbuffer Sampling on OpenGL”。"
    state machine
}

DreamBackgroundPixelate:ApplyAlphaToStrength {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamBackgroundPixelate.h#DreamBackgroundPixelate:ApplyAlphaToStrength
    src   "Will alpha affect pixelate strength? If true, then 0 alpha means 0 pixelate strength, and 1 alpha means full pixelate strength."
    text  "是否使 Alpha 值影响像素化强度？如果为真，则 0 Alpha 表示 0 像素化强度，1 Alpha 表示完全像素化。"
    state machine
}

