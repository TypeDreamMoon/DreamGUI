    state machine
}

DreamGlass:Dispersion {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:Dispersion
    src   "How much less red and more blue bend than green: 0 none."
    text  "红色比绿色弯折得少、蓝色比绿色弯折得多的程度：0 表示无。"
    state machine
}

DreamGlass:EdgeWidth {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:EdgeWidth
    src   "The band along the edge that bends the light, in units."
    text  "沿边缘弯折光线的条带宽度，以单位计。"
    state machine
}

DreamGlass:Frost {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:Frost
    src   "0 clear, 1 as frosted as a progressive blur's strongest level."
    text  "0 为清晰，1 为与渐进模糊最强级别相同的磨砂程度。"
    state machine
}

DreamGlass:LightAngle {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:LightAngle
    src   "Where the light comes from: degrees, 0 from above, clockwise."
    text  "光源的方向：以度为单位，0 为从上方，顺时针。"
    state machine
}

DreamGlass:Refraction {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:Refraction
    src   "How far the edge bends the light, in units: what a pixel at the very edge shows is this far further in."
    text  "边缘弯曲光线的距离（单位）：最边缘的像素会显示再向内这么远的内容。"
    state machine
}

DreamGlass:Saturation {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:Saturation
    src   "What is seen through is this many times as saturated."
    text  "透过它看到的内容，饱和度为此值的倍数。"
    state machine
}

DreamGlass:SetShapeBlendGroup {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:SetShapeBlendGroup
    src   "The widget whose shape blend group the glass takes its shape from (Shape ShapeBlend); none for this widget's own."
    text  "玻璃从其形状混合组获取形状的控件（Shape ShapeBlend）；留空则使用此控件自身的。"
    state machine
}

DreamGlass:ShapeBlendGroup {
    at    Source/DreamGUIExtensions/Public/Extensions/Effects/DreamGlass.h#DreamGlass:ShapeBlendGroup
    src   "The widget whose shape blend group (UDreamShapeBlendGroup) the glass takes its shape from: none for this widget's own.\nIts rect blocks draw the melted shape too, in their colours; transparent ones leave only the glass."
    text  "玻璃采用其形状混合组（UDreamShapeBlendGroup）来确定形状的控件：留空则使用此控件自身的形状混合组。\n它的矩形块也会用各自的颜色绘制融合后的形状；透明的矩形块则只留下玻璃。"
    state machine
}

