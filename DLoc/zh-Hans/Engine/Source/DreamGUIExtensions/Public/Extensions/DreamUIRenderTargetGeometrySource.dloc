    state draft
}

EDreamUIRenderTargetGeometryMode.StaticMesh {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamUIRenderTargetGeometrySource.h#EDreamUIRenderTargetGeometryMode:StaticMesh
    src   "RenderTarget mapped onto a static mesh. This component must attach to target StaticMeshComponent so we can find and use it.\nAnd in order to interact by DreamUIRenderTargetInteraction, the 'Support UV From Hit Results' must be enabled in project settings."
    text  "将渲染目标映射到静态网格上。此组件必须附加到目标 StaticMeshComponent，以便我们找到并使用它。\n要通过 DreamUIRenderTargetInteraction 进行交互，必须在项目设置中启用“支持从命中结果 UV”。"
    state machine
}
