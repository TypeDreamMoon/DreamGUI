namespace UObjectToolTips

DreamUIRenderTargetGeometrySource {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamUIRenderTargetGeometrySource.h#DreamUIRenderTargetGeometrySource
    src   "This component can generate a geometry to display DreamUI's render target, and perform interaction source for DreamUIRenderTargetInteraction component."
    text  "此组件可以生成几何体以显示 DreamUI 的渲染目标，并为 DreamUIRenderTargetInteraction 组件提供交互源。"
    state machine
}

DreamUIRenderTargetGeometrySource:bEnableInteractOnBackside {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamUIRenderTargetGeometrySource.h#DreamUIRenderTargetGeometrySource:bEnableInteractOnBackside
    src   "Enable backside interaction? Front side always interactable."
    text  "启用背面交互？正面始终可交互。"
    state machine
}

DreamUIRenderTargetGeometrySource:bFlipVerticalOnGLES {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamUIRenderTargetGeometrySource.h#DreamUIRenderTargetGeometrySource:bFlipVerticalOnGLES
    src   "INERT. Android GLES rendered the target flipped, and this set the material's \"FlipY\" scalar to\nflip it back; the engine stopped needing that at UE 5.1, and the code that read this flag has\nbeen compiled out since (it was `#if PLATFORM_ANDROID && 0`). The property is kept so assets\nthat stored it still load, and setting it does nothing on any platform."
    text  "已失效。Android GLES 渲染目标时是翻转的，此项会将材质的“FlipY”标量设为\n翻转回来；从 UE 5.1 起引擎不再需要这样做，读取此标志的代码\n此后已被编译排除（原为 `#if PLATFORM_ANDROID && 0`）。保留该属性是为了让\n存储过它的资产仍能加载，在任何平台上设置它都不会产生任何效果。"
    state machine
}

DreamUIRenderTargetGeometrySource:BodySetup {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamUIRenderTargetGeometrySource.h#DreamUIRenderTargetGeometrySource:BodySetup
    src   "The body setup of the displayed quad"
    // from the engine's zh-Hans
    text  "显示四边形的形体设置"
    state draft
}

DreamUIRenderTargetGeometrySource:bOverrideStaticMeshMaterial {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamUIRenderTargetGeometrySource.h#DreamUIRenderTargetGeometrySource:bOverrideStaticMeshMaterial
    src   "Use this component's material for target static mesh component."
    text  "使用此组件的材质，用于目标静态网格组件。"
    state machine
}

DreamUIRenderTargetGeometrySource:CylinderArcAngle {
    at    Source/DreamGUIExtensions/Public/Extensions/DreamUIRenderTargetGeometrySource.h#DreamUIRenderTargetGeometrySource:CylinderArcAngle
    src   "Curvature of a cylindrical widget in degrees."
    // from the engine's zh-Hans
