    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsView.h#DreamLyricsView:ActiveLineAnchor
    src   "Where the current line's top sits, as a fraction of the view's height from the top."
    text  "当前行顶部所在的位置，以距视图顶部占视图高度的比例表示。"
    state machine
}

