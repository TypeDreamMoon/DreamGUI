namespace UObjectToolTips

DreamLyricLine {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricLine
    src   "A line: its words in order, the line's own time span, and optional secondary texts."
    text  "一行歌词：其单词的顺序、行本身的持续时间，以及可选的辅助文本。"
    state machine
}

DreamLyricLine:bBackground {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricLine:bBackground
    src   "A backing vocal, shown smaller."
    text  "伴唱，显示为较小的字体。"
    state machine
}

DreamLyricLine:bSecondary {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricLine:bSecondary
    src   "Sung by the second voice (a duet); players usually right-align these."
    text  "由第二声部演唱的歌曲（二重唱）；通常右对齐显示。"
    state machine
}

DreamLyricLine:Roman {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricLine:Roman
    src   "A romanization / pronunciation guide, when the source carries one."
    text  "音译/发音指南，如果原始文本包含。"
    state machine
}

DreamLyricLine:Translation {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricLine:Translation
    src   "A translation shown under the line, when the source carries one."
    text  "当原始文本包含翻译时，在行下方显示该翻译。"
    state machine
}

DreamLyricsLibrary:ParseLRC {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricsLibrary:ParseLRC
    src   "Parse LRC: \"[mm:ss.xx]text\" lines, with inline <mm:ss.xx> word times when present (enhanced LRC).\nLine ends are the next line's start."
}

DreamLyricsLibrary:ParseTTML {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricsLibrary:ParseTTML
    src   "Parse TTML of the kind Apple Music and AMLL use: <p begin end> lines of <span begin end> words,\nwith ttm:agent for the second voice, ttm:role=\"x-bg\" spans for backing vocals and\nttm:role=\"x-translation\" / \"x-roman\" spans for the secondary texts. A <p> without word spans\nbecomes one word spanning the line."
}

DreamLyricWord {
    at    Source/DreamGUIExtensions/Public/Extensions/Lyrics/DreamLyricsData.h#DreamLyricWord
    src   "One timed word (or syllable) of a lyric line. Times are seconds from the start of the track."
    text  "歌词行中的一个带有时间戳的单词（或音节）。时间戳表示从歌曲开始的秒数。"
    state machine
}

