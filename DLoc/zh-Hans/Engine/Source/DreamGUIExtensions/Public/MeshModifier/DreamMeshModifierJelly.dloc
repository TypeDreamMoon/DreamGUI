}

DreamMeshModifierJelly:DampingRatio {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:DampingRatio
    src   "1 settles without overshoot, less wobbles longer."
    text  "为 1 时无过冲地稳定下来，越小晃动得越久。"
    state machine
}

DreamMeshModifierJelly:DragStretch {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:DragStretch
    src   "How much of a drag's distance the nearest points follow while the widget is dragged: 0 ignores drags."
    text  "拖动控件时，最近的点跟随拖动距离的比例：0 表示忽略拖动。"
    state machine
}

DreamMeshModifierJelly:DragTo {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:DragTo
    src   "A drag as the pointer would make it: from where it was pressed to InLocalPoint. EndDrag lets go."
    text  "按指针的方式拖动：从按下处到 InLocalPoint。EndDrag 松开。"
    state machine
}

DreamMeshModifierJelly:Frequency {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:Frequency
    src   "Oscillations a second: higher is stiffer."
    text  "每秒振荡次数：越高越僵硬。"
    state machine
}

DreamMeshModifierJelly:Inertia {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:Inertia
    src   "How much the widget's own acceleration pushes the points: 0 ignores its moves."
    text  "控件自身加速度对点的推动程度：0 表示忽略其移动。"
    state machine
}

DreamMeshModifierJelly:MaxStretch {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:MaxStretch
    src   "How far a point may stretch, as a share of the box's larger side."
    text  "单个点可拉伸的最大距离，以盒子较长边的占比表示。"
    state machine
}

DreamMeshModifierJelly:Poke {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:Poke
    src   "A push at once: every point's velocity changed by InVelocity (local units a second) times its share."
    text  "一次性推动：每个点的速度改变 InVelocity（本地单位每秒）乘以其占比。"
    state machine
}

DreamMeshModifierJelly:PressSquash {
    at    Source/DreamGUIExtensions/Public/MeshModifier/DreamMeshModifierJelly.h#DreamMeshModifierJelly:PressSquash
    src   "How far the points draw in towards the press while the widget is pressed, as a share of their distance from it."
    text  "控件被按下时，点向按下处收拢的程度，以它们到该处距离的占比表示。"
