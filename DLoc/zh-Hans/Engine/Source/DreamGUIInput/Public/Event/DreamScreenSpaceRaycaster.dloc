namespace UObjectToolTips

DreamScreenSpaceRaycaster {
    at    Source/DreamGUIInput/Public/Event/DreamScreenSpaceRaycaster.h#DreamScreenSpaceRaycaster
    src   "Perform a raycaster interaction for ScreenSpaceUI.\nThis component should be placed on a actor which have a DreamCanvas, and RenderMode should set to ScreenSpaceOverlay."
    text  "执行 ScreenSpaceUI 的射线投射交互。\n此组件应放置在具有 DreamCanvas 的 Actor 上，并且渲染模式应设置为 ScreenSpaceOverlay。"
    state machine
}

DreamScreenSpaceRaycaster:bHoldToDrag {
    at    Source/DreamGUIInput/Public/Event/DreamScreenSpaceRaycaster.h#DreamScreenSpaceRaycaster:bHoldToDrag
    src   "hold press for a little while to entering drag mode"
    text  "按住一段时间以进入拖动模式。"
    state machine
}

DreamScreenSpaceRaycaster:DragThreshold {
