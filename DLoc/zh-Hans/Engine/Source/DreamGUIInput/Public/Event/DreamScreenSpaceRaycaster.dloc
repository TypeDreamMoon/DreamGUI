    text  "拖动阈值，以目标对象的局部空间计算。"
    state machine
}

DreamScreenSpaceRaycaster:GetScaledDragThresholdSquare {
    at    Source/DreamGUIInput/Public/Event/DreamScreenSpaceRaycaster.h#DreamScreenSpaceRaycaster:GetScaledDragThresholdSquare
    src   "DragThresholdSquare taken into the pointer's own units: the authored threshold is in canvas units\nand the pointer is measured in viewport pixels, which differ by exactly the root canvas's scale.\nThis is what ShouldStartDrag compares against."
    text  "将DragThresholdSquare换算为指针自身的单位：所设阈值以画布为单位，\n而指针以视口像素计量，两者正好相差根画布的缩放。\nShouldStartDrag比较的正是该值。"
    state machine
}

DreamScreenSpaceRaycaster:HoldToDragTime {
