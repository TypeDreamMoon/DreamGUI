DreamUIDropTarget {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget
    src   "Makes its widget a drop TARGET: reads the operation off a drop that lands here, filters by tag\nand payload class, and on acceptance marks the operation handled and broadcasts. A drop this\ntarget refuses keeps bubbling, so nested targets behave like nested anything else."
    text  "使其控件成为放置目标：从落到此处的放置中读取操作，按标签\n和载荷类进行筛选，接受时将操作标记为已处理并广播。此\n目标拒绝的放置会继续冒泡，因此嵌套目标的行为与其他嵌套对象一样。"
    state machine
}

DreamUIDropTarget:CanAcceptDrop {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget:CanAcceptDrop
    src   "The acceptance decision. The default checks RequiredTag and RequiredPayloadClass."
    text  "接受判定。默认实现检查 RequiredTag 和 RequiredPayloadClass。"
    state machine
}

DreamUIDropTarget:HandleAcceptedDrop {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget:HandleAcceptedDrop
    src   "What acceptance DOES, before the delegates fire. The default does nothing but exist to override."
    text  "接受时执行的操作，位于委托触发之前。默认实现不做任何事，仅供重写。"
    state machine
}

DreamUIDropTarget:IsDragHovered {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget:IsDragHovered
    src   "True while any live acceptable operation is hovering this target."
    text  "当有任何有效的可接受操作悬停在此目标上时为 true。"
    state machine
}

DreamUIDropTarget:OnDragEnter {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget:OnDragEnter
    src   "Drop-hover feedback, driven by UDreamUIDragDropSubsystem while a drag is in flight. Enter and\nLeave fire once each per operation at the edges, Over fires every frame in between -- so a slot can light up\nthe moment a payload it can take arrives over it, instead of the acceptance decision being\ninvisible until the player lets go.\n\nOnly the target that WOULD accept the drop is hovered: CanAcceptDrop is asked before Enter,\nexactly as it is asked on the drop itself, and a refusing target is skipped for whichever\nancestor accepts -- the same bubbling the drop does."
    text  "拖放悬停反馈，在拖动进行期间由 UDreamUIDragDropSubsystem 驱动。Enter 和\nLeave 在操作的两端各触发一次，Over 则在两者之间的每一帧触发——因此插槽可以在\n可接受的载荷到达其上方的那一刻就亮起，而不必等玩家松手后才让接受判定\n变得可见。\n\n只有会接受该拖放的目标才会收到悬停：CanAcceptDrop 在 Enter 之前被询问，\n与在拖放本身上询问的时机完全相同，被拒绝的目标会被跳过，交给接受它的\n祖先目标——与拖放本身相同的冒泡方式。"
    state machine
}

DreamUIDropTarget:OnDropAccepted {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget:OnDropAccepted
    src   "Fired after HandleAcceptedDrop, before the operation's own OnDropHandled."
    text  "在 HandleAcceptedDrop 之后、操作自身的 OnDropHandled 之前触发。"
    state machine
}

DreamUIDropTarget:RequiredPayloadClass {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget:RequiredPayloadClass
    src   "Accept only payloads of this class. Null accepts any payload, including none."
    text  "仅接受此类的载荷。为 null 时接受任何载荷，包括无载荷。"
    state machine
}

DreamUIDropTarget:RequiredTag {
    at    Source/DreamGUIInput/Public/Interaction/DreamUIDragDrop.h#DreamUIDropTarget:RequiredTag
    src   "Accept only operations with this tag. None accepts any tag."
    text  "仅接受带此标签的操作。为 None 时接受任何标签。"
    state machine
}
