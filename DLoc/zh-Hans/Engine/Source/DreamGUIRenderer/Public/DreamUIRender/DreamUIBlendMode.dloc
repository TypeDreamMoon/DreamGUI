    state machine
}

EDreamUIBlendMode.PinLight {
    at    Source/DreamGUIRenderer/Public/DreamUIRender/DreamUIBlendMode.h#EDreamUIBlendMode:PinLight
    src   "Darken or lighten, by the element."
    text  "通过元素进行加深或提亮。"
