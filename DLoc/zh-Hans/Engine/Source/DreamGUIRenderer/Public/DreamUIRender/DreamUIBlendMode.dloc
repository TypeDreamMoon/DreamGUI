}

EDreamUIBlendMode.Saturation {
    at    Source/DreamGUIRenderer/Public/DreamUIRender/DreamUIBlendMode.h#EDreamUIBlendMode:Saturation
    src   "The element's saturation, with the hue and luminosity of what is behind."
