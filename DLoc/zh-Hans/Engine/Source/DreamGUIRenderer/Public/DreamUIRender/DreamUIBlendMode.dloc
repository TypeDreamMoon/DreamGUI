    state machine
}

EDreamUIBlendMode.Screen {
    at    Source/DreamGUIRenderer/Public/DreamUIRender/DreamUIBlendMode.h#EDreamUIBlendMode:Screen
    src   "The inverse of multiplying the inverses: always lighter, never past white."
    text  "与相乘的逆运算相同，始终更亮，且不会超过白色。"
    state machine
}

EDreamUIBlendMode.SoftLight {
    at    Source/DreamGUIRenderer/Public/DreamUIRender/DreamUIBlendMode.h#EDreamUIBlendMode:SoftLight
    src   "A gentle darken or lighten by the element, like a diffuse light on what is behind."
    text  "元素对背景产生轻微的加深或提亮效果，如同柔和的光照。"
    state machine
}

EDreamUIBlendMode.Subtract {
    at    Source/DreamGUIRenderer/Public/DreamUIRender/DreamUIBlendMode.h#EDreamUIBlendMode:Subtract
    src   "The element taken away from what is behind."
