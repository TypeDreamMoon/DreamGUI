DreamBaseEventData:SelectedComponent {
    at    Source/DreamGUI/Public/Event/DreamBaseEventData.h#DreamBaseEventData:SelectedComponent
    src   "current selected component. when call Deselect interface, this is also the new selected component"
    text  "当前选中的组件。调用 Deselect 接口时，此属性也是新的选中组件。"
    state machine
}

EDreamUIMouseButtonType.UserDefined1 {
    at    Source/DreamGUI/Public/Event/DreamBaseEventData.h#EDreamUIMouseButtonType:UserDefined1
    src   "UserDefinedX is for custom defined input button type.\n\nDeliberately kept although no plugin code produces one: these are the extension point for a\nproject that has a fourth or fifth button, which reaches them by passing one to\nUDreamStandaloneInputModule::InputTrigger. \"Unused inside the plugin\" is what they are for."
    text  "UserDefinedX 用于自定义输入按钮类型。\n\n尽管插件代码不会产生这种类型，仍特意保留：它们是供\n项目使用的扩展点；项目若有第四个或第五个按钮，可通过将其传给\nUDreamStandaloneInputModule::InputTrigger 来使用。“在插件内未使用”正是它们的用途。"
    state machine
}

EDreamUIPointerEventType.DoubleClick {
    at    Source/DreamGUI/Public/Event/DreamBaseEventData.h#EDreamUIPointerEventType:DoubleClick
    src   "The second press on the same widget inside DoubleClickTime, sent instead of its Down. Its Up and Click still follow."
    text  "在 DoubleClickTime 范围内，对同一控件的第二次按下会发送 DoubleClick 事件，而不是 Down 事件。其 Up 和 Click 事件仍然会触发。"
    state machine
}

EDreamUIPointerEventType.LongPress {
    at    Source/DreamGUI/Public/Event/DreamBaseEventData.h#EDreamUIPointerEventType:LongPress
    src   "The trigger held on one widget for LongPressTime without becoming a drag."
    text  "在 LongPressTime 范围内，持续按住一个控件，不会触发拖动事件。"
    state machine
}

EDreamUIPointerEventType.Pinch {
    at    Source/DreamGUI/Public/Event/DreamBaseEventData.h#EDreamUIPointerEventType:Pinch
    src   "Two pointers moving together or apart. Carried by UDreamGestureEventData."
    text  "两个指针同时向内或向外移动。由 UDreamGestureEventData 携带。"
    state machine
}

EDreamUIPointerEventType.Swipe {
    at    Source/DreamGUI/Public/Event/DreamBaseEventData.h#EDreamUIPointerEventType:Swipe
    src   "One pointer travelling far enough, fast enough, in one direction. Carried by UDreamGestureEventData."
    text  "一个指针在某个方向上移动足够远，速度足够快。由 UDreamGestureEventData 携带。"
    state machine
}
