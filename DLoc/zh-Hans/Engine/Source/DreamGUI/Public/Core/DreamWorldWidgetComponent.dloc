namespace UObjectToolTips

DreamWorldWidgetComponent {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent
    src   "Hosts a DreamUI hierarchy in the world: the component that puts a panel, a health bar or a sign\nwhere an actor is.\n\nIt is the one host for world-space UI, and it owns every decision a world-space root has to make,\nbecause none of them can come from the hierarchy itself: how big it is in centimetres (a screen\nstretches to a viewport, a world panel has no viewport to stretch to), which renderer draws it,\nwhat it sorts against, and which trace channel a pointer must use to reach it. The hierarchy is\ninstanced from WidgetClass unchanged -- its own root canvas is kept, so whatever the designer set\nthere is what the level gets, and a hierarchy authored with no canvas is given one.\n\nThe properties are live: changing the size, the pivot, the backend or the sort order re-applies to\nthe tree that is already loaded. Only a change of class rebuilds it."
    text  "在世界中承载DreamUI层级：该组件把面板、血条或标牌\n放在Actor所在的位置。\n\n它是世界空间UI的唯一宿主，世界空间根需要做出的每个决定都由它负责，\n因为其中任何一个都无法来自层级本身：它以厘米为单位的尺寸（屏幕\n会拉伸到视口，而世界面板没有可拉伸的视口）、由哪个渲染器绘制、\n它与什么进行排序，以及指针必须使用哪个追踪通道才能命中它。层级\n从控件类（WidgetClass）原样实例化——其自身的根画布会被保留，因此设计器在其\n中设置的内容就是关卡得到的内容；对于创作时没有画布的层级，会为其提供一个画布。\n\n这些属性是实时的：更改尺寸、轴心、后端或排序顺序会重新应用到\n已经加载的树上。只有更改类才会重建它。"
    state machine
}

DreamWorldWidgetComponent:bUseDesignSize {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent:bUseDesignSize
    src   "Take the size from the class instead of from DrawSize. On by default: the canvas the hierarchy\nwas authored against is the only size anyone has actually chosen for it, and a host that lands\nat that size is a host that looks in the level like it looked in the designer."
    text  "从类而不是从 DrawSize 获取尺寸。默认开启：层级创作时所依据的画布\n是唯一有人真正为它选定的尺寸，而落在该尺寸上的宿主，\n在关卡中看起来就与在设计器中的样子一致。"
    state machine
}

DreamWorldWidgetComponent:DrawSize {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent:DrawSize
    src   "The root's size in world units, when it is not taken from the class."
    text  "未从类中获取时，根在世界单位下的尺寸。"
    state machine
}

DreamWorldWidgetComponent:GetDrawSize {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent:GetDrawSize
    src   "The size the root is actually given: the class's design size while bUseDesignSize is on."
    text  "根实际获得的尺寸：当 bUseDesignSize 开启时为类的设计尺寸。"
    state machine
}

DreamWorldWidgetComponent:Pivot {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent:Pivot
    src   "Where on the root this component sits: (0.5, 0.5) centres the panel on the actor."
    text  "该组件位于根上的位置：(0.5, 0.5) 会将面板居中到 Actor 上。"
    state machine
}

