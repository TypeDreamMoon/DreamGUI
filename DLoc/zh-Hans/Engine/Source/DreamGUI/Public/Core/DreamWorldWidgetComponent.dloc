DreamWorldWidgetComponent:SortOrder {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent:SortOrder
    src   "Draw order against the other canvases in the world. Written through to the root canvas."
    text  "在世界中与其他画布的绘制顺序一致。此值会传递到根画布。"
    state machine
}

DreamWorldWidgetComponent:TraceChannel {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent:TraceChannel
    src   "The channel a world-space raycaster must be set to for its rays to reach this hierarchy, and\nthe channel its occlusion trace uses. Visibility by default, which is what a raycaster created\nfor a player defaults to, so the two meet without anyone configuring either."
    text  "世界空间射线检测器必须设置的通道，其射线才能到达此层级，\n也是其遮挡追踪使用的通道。默认为可视性，即为玩家创建的射线检测器\n默认使用的通道，因此两者无需任何配置即可匹配。"
    state machine
}

DreamWorldWidgetComponent:WidgetClass {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#DreamWorldWidgetComponent:WidgetClass
    src   "The hierarchy class to present. Changing it is the one edit that rebuilds the tree."
    text  "要呈现的层次结构类。更改此项是重建树的唯一编辑操作。"
    state machine
}

EDreamWorldWidgetBackend {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#EDreamWorldWidgetBackend
    src   "Which renderer draws a world-space hierarchy. Maps to the root canvas's render mode."
    text  "用于绘制世界空间层次结构的渲染器。映射到根画布的渲染模式。"
    state machine
}

EDreamWorldWidgetBackend.DreamUIRenderer {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#EDreamWorldWidgetBackend:DreamUIRenderer
    src   "DreamUI's own renderer: the hierarchy is drawn by the view extension, after the scene, with\nDreamUI's sorting. Sharper text and exact draw order, no scene lighting or post processing."
    text  "DreamGUI自带的渲染器：层级由视图扩展在场景之后绘制，使用\nDreamGUI的排序。文本更清晰、绘制顺序精确，但没有场景光照和后处理。"
    state machine
}

EDreamWorldWidgetBackend.UERenderer {
    at    Source/DreamGUI/Public/Core/DreamWorldWidgetComponent.h#EDreamWorldWidgetBackend:UERenderer
    src   "UE's renderer: the meshes are ordinary primitives in the scene, so they light, cast, fog and\nocclude like anything else, and sort by translucency rules rather than by DreamUI's."
    text  "UE的渲染器：网格是场景中的普通图元，因此会像其他物体一样接受光照、投射阴影、受雾影响并\n参与遮挡，且按半透明规则排序，而不是按DreamGUI的规则。"
    state machine
}

