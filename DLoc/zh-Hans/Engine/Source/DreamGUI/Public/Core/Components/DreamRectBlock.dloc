    src   "Nine-slice with the middle left out -- a frame drawn around whatever is behind it."
    text  "去掉中部的九宫格——围绕其后方内容绘制的边框。"
    state machine
}

EDreamRectBlockTextureDrawMode.Box {
    at    Source/DreamGUI/Public/Core/Components/DreamRectBlock.h#EDreamRectBlockTextureDrawMode:Box
    src   "Nine-slice: the margins keep their authored pixel size and only the middle stretches."
