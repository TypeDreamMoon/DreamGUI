namespace UObjectToolTips

DreamVisualPostProcess {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess
    src   "UI element that can do post-processing effect on screen space.\nOnly valid on DreamUIRenderer (ScreenSpaceUI or WorldSpace-DreamUIRenderer)."
    text  "可在屏幕空间执行后处理效果的UI元素。\n仅对DreamUIRenderer（ScreenSpaceUI或WorldSpace-DreamUIRenderer）有效。"
    state machine
}

DreamVisualPostProcess:AutoOutputRenderTarget {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:AutoOutputRenderTarget
    src   "The output render target this visual made because none was assigned. Held apart from\nOutputRenderTarget, which is the author's: never saved, duplicated or copied."
    text  "由于未指定而由该视觉元素自行创建的输出渲染目标。与\nOutputRenderTarget分开保存，后者属于作者：从不保存、复制或拷贝。"
    state machine
}

DreamVisualPostProcess:bEnabled {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:bEnabled
    src   "Off, the effect draws nothing: to compare with and without it."
    text  "关闭时，效果不绘制任何内容：用于对比开启与关闭时的效果。"
    state machine
}

DreamVisualPostProcess:bUseFullSize {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:bUseFullSize
    src   "Use root canvas size instead of just this UI element rect area.\nFor screen-space-overlay UI, this will act as full screen size.\nFor world-space-DreamUI, this will use root canvas size."
    text  "使用根画布尺寸，而不是仅使用此 UI 元素矩形区域。\n对于屏幕空间叠加 UI，它将充当全屏尺寸。\n对于世界空间 DreamUI，它将使用根画布尺寸。"
    state machine
}

DreamVisualPostProcess:MaskTexture {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:MaskTexture
    src   "Use maskTexture's red channel to mask out effect result."
    text  "使用maskTexture纹理的红色通道遮罩效果结果。"
    state machine
}

DreamVisualPostProcess:MaskTextureUVRect {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:MaskTextureUVRect
    src   "MaskTexture UV offset and scale info. Only get good result when MaskTextureType is Simple"
    text  "遮罩纹理的 UV 偏移和缩放信息。仅当 MaskTextureType 为 Simple 时才能获得最佳效果。"
    state machine
}

DreamVisualPostProcess:OutputRenderTarget {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:OutputRenderTarget
    src   "Blur result will output to this RenderTarget.\nWill create one if not specified."
    text  "模糊处理的结果将输出到此渲染目标。\n如果未指定，则会自动创建一个。"
    state machine
}

DreamVisualPostProcess:SetEnabled {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:SetEnabled
    src   "Off, the effect draws nothing and what it covers shows as if it were not there; every setting is kept."
    text  "关闭时，该效果不绘制任何内容，被遮盖的部分会显示为未被遮盖的状态；所有设置都将保留。"
    state machine
}

DreamVisualPostProcess:TintMode {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:TintMode
    src   "How this visual's Color tints the captured background.\nOnly the RGB of Color is used — its alpha keeps whatever meaning the effect gives it (background blur\nreads alpha as blur strength), so TintStrength controls how strongly the tint applies."
    text  "该视觉元素的Color如何为捕获的背景着色。\n仅使用Color的RGB——其alpha保留效果赋予它的含义（背景模糊\n将alpha读取为模糊强度），因此由TintStrength控制着色的强度。"
    state machine
}

DreamVisualPostProcess:TintStrength {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#DreamVisualPostProcess:TintStrength
    src   "0 leaves the background untouched in every mode; 1 applies the tint fully."
    text  "0 会在所有模式下保持背景不变；1 会完全应用着色。"
    state machine
}

EDreamBackgroundBlurRenderType.RenderTarget {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#EDreamBackgroundBlurRenderType:RenderTarget
    src   "Output to a RenderTarget"
    text  "输出到渲染目标。"
    state machine
}

EDreamBackgroundBlurRenderType.Screen {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#EDreamBackgroundBlurRenderType:Screen
    src   "Render direct to screen"
    text  "直接渲染到屏幕。"
    state machine
}

EDreamPostProcessTintMode {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#EDreamPostProcessTintMode
    src   "How a post-process visual's Color is combined with the background it captured."
    text  "此后处理视觉的颜色如何与捕获的背景结合。"
    state machine
}

EDreamPostProcessTintMode.Additive {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#EDreamPostProcessTintMode:Additive
    src   "result = background + Color * Strength. Glow-like brightening."
    text  "result = background + Color * Strength。类似于发光的效果。"
    state machine
}

EDreamPostProcessTintMode.Blend {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#EDreamPostProcessTintMode:Blend
    src   "result = lerp(background, Color, Strength). Washes the background towards Color, and can lighten it."
    text  "result = lerp(background, Color, Strength)。使背景向颜色靠拢，并可以使其变亮。"
    state machine
}

EDreamPostProcessTintMode.Multiply {
    at    Source/DreamGUI/Public/Core/Components/DreamVisualPostProcess.h#EDreamPostProcessTintMode:Multiply
    src   "result = background * Color. Can only darken or colourise; white leaves it untouched."
    text  "result = background * Color。只能使背景变暗或着色；白色不会改变它。"
    state machine
}

