    state machine
}

DreamVisual:Color {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:Color
    src   "Render color of UI element."
    text  "UI 元素的渲染颜色。"
    state machine
}

DreamVisual:CustomRaycastObject {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:CustomRaycastObject
    src   "Custom raycast object to handle raycast behaviour when DreamUI do raycast hit test. Only valid if RaycastType is Custom."
    text  "用于处理 DreamUI 进行光线投射测试时光线投射行为的自定义光线投射对象。仅当 RaycastType 为 Custom 时有效。"
    state machine
}

DreamVisual:GetFinalAlpha01 {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:GetFinalAlpha01
    src   "get final alpha, calculated with CanvasGroup's alpha"
    text  "获取最终 alpha 值，由 CanvasGroup 计算得出。"
    state machine
}

DreamVisual:GetFinalColor {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:GetFinalColor
    src   "The colour this visual is drawn with: Color, times the content tint of every widget above it\n(UDreamWidget::GetInheritedContentTint) and ColorMultiplier, in linear space, with the alpha then scaled by the\nhierarchy's render opacity. Exactly Color with that alpha while both tints are white."
    text  "此视觉对象绘制所用的颜色：Color 乘以它上方每个控件的内容着色\n（UDreamWidget::GetInheritedContentTint）以及 ColorMultiplier，在线性空间中计算，随后 alpha 按\n层级的渲染不透明度缩放。两个着色均为白色时，恰好等于带有该 alpha 的 Color。"
    state machine
}

DreamVisual:GetVisualType {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:GetVisualType
    src   "get visual type"
    text  "获取视觉类型。"
    state machine
}

DreamVisual:SetColorMultiplier {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:SetColorMultiplier
    src   "A colour this visual's own Color is multiplied by on its way to the screen, in linear space -- what something\nthat tints a visual without owning its Color writes: a border's BrushColor, and the alpha it draws at while\ndisabled; a scroll box's bar track, dimmed while it is idle. Runtime state, not saved. White changes nothing."
    text  "此视觉对象自身的 Color 在输送到屏幕途中要乘上的颜色，在线性空间中计算——即某些在不拥有其 Color 的情况下为视觉对象着色的对象所写入的值：\n边框的笔刷颜色（BrushColor），以及它在禁用状态下绘制时的 alpha；滚动框的滚动条轨道，在空闲时变暗。\n运行时状态，不保存。白色不改变任何内容。"
    state machine
}

DreamVisual:SetCustomRaycastObject {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:SetCustomRaycastObject
    src   "Set custom raycast object to handle raycast behaviour, only valid if RaycastType is Custom"
    text  "设置自定义的射线投射对象，用于处理射线投射行为，仅当 RaycastType 为 Custom 时有效。"
    state machine
}

DreamVisual:VisiblePixelThreshold {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisual:VisiblePixelThreshold
    src   "Pixel's alpha value threshold, if hit a pixel which alpha value is less than this value, then hit test return false."
    text  "像素的 alpha 值阈值。如果命中的像素的 alpha 值小于此值，则射线投射测试将返回 false。"
    state machine
}

DreamVisualCustomRaycast {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisualCustomRaycast
    src   "This component is only used when DreamVisual's RaycastType = Custom"
    text  "此组件仅在 DreamVisual 的 RaycastType 为 Custom 时使用。"
    state machine
}

DreamVisualCustomRaycast:GetRaycastPixelFromUIBatchMeshVisual {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisualCustomRaycast:GetRaycastPixelFromUIBatchMeshVisual
    src   "Get pixel value at hit point.\nOnly support UI element type which can read pixel value from texture:\n             1. UISprite which use DreamGUIStaticSpriteAtlasData can work perfectly.\n             2. UITexture can work with some specific setting.\n             3. UIText which use dynamic font can not work. (Currently all DreamGUI's built-in font is dynamic)\nWill fallback to Geometry if ui element not support this raycast type."
    text  "获取命中的像素值。\n仅支持以下类型的 UI 元素，这些元素可以从纹理中读取像素值：\n             1. 使用 DreamGUIStaticSpriteAtlasData 的 UISprite 可以完美工作。\n             2. UITexture 可以通过某些特定设置工作。\n             3. 使用动态字体的 UIText 无法工作。（目前所有 DreamGUI 的内置字体都是动态的）\n如果 UI 元素不支持此射线投射类型，则会回退到几何体。"
    state machine
}

DreamVisualCustomRaycast:ReceiveRaycast {
    at    Source/DreamGUI/Public/Core/Components/DreamVisual.h#DreamVisualCustomRaycast:ReceiveRaycast
    src   "Called by DreamVisual when do raycast hit test.\n@param       InVisual                        The DreamVisual object which call this Raycast function\n@param       InLocalSpaceRayStart    Ray start point in this UI's local space\n@param       InLocalSpaceRayEnd              Ray end point in this UI's local space\n@param       OutHitPoint                             Hit point position in this UI's local space\n@param       OutHitNormal                    Hit point normal in this UI's local space\n@return      true if hit this UI object"
    text  "由 DreamVisual 调用以执行射线投射测试。\n@param       InVisual                        调用此射线投射函数的 DreamVisual 对象。\n@param       InLocalSpaceRayStart    射线起点，以此 UI 的本地坐标系表示。\n@param       InLocalSpaceRayEnd              射线终点，以此 UI 的本地坐标系表示。\n@param       OutHitPoint                             命中的点位置，以此 UI 的本地坐标系表示。\n@param       OutHitNormal                    命中的点的法线，以此 UI 的本地坐标系表示。\n@return      如果命中此 UI 对象，则返回 true。"
    state machine
}

EDreamVisualRaycastType {
