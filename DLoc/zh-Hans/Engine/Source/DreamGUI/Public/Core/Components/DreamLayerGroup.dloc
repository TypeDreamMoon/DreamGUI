    text  "如何将组合的子树与后面的内容混合。"
    state machine
}

DreamLayerGroup:GroupMask {
    at    Source/DreamGUI/Public/Core/Components/DreamLayerGroup.h#DreamLayerGroup:GroupMask
    src   "Masks the composited subtree as it is put down, measured in this widget's rect; not in hit tests."
    text  "将组合的子树进行遮罩，遮罩位置由此小部件的矩形区域确定，不参与碰撞检测。"
    state machine
}

DreamLayerGroup:GroupOpacity {
    at    Source/DreamGUI/Public/Core/Components/DreamLayerGroup.h#DreamLayerGroup:GroupOpacity
    src   "Applied once to the composited subtree, so overlapping children fade together."
    text  "对合成后的子树整体应用一次，因此重叠的子项会一起淡出。"
    state machine
}

DreamLayerGroup:IsIsolated {
    at    Source/DreamGUI/Public/Core/Components/DreamLayerGroup.h#DreamLayerGroup:IsIsolated
    src   "Whether the subtree is drawn apart: Isolated, or an opacity, a mode or a mask other than the default asks for it."
    text  "子树是否单独绘制：由 Isolated 指定，或由非默认的不透明度、混合模式或遮罩触发。"
    state machine
}

DreamLayerGroup:SetEnabled {
    at    Source/DreamGUI/Public/Core/Components/DreamLayerGroup.h#DreamLayerGroup:SetEnabled
