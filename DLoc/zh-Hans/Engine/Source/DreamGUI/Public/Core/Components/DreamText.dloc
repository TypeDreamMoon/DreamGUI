DreamText:SetPaintCenterOffset {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:SetPaintCenterOffset
    src   "Fractions of the box added to every paint's centre (and to a Linear's mid-point). Not saved."
    text  "以框的比例加到每个绘制的中心（以及 Linear 的中点）。不保存。"
    state machine
}

DreamText:SetPaintScale {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:SetPaintScale
    src   "Times every paint's Scale: above 1 stretches the gradients, below 1 squeezes them. Not saved."
    text  "乘以每个绘制的 Scale：大于 1 拉伸渐变，小于 1 压缩渐变。不保存。"
    state machine
}

DreamText:SetSmallTextRaster {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:SetSmallTextRaster
    src   "A repaint, never a layout: coverage glyphs only replace quads."
    text  "只重绘，绝不重新布局：覆盖字形只替换四边形。"
    state machine
}

DreamText:SetTagColorOverride {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:SetTagColorOverride
    src   "Draw the glyphs of one rich-text tag in InColor instead of the colour the markup gives them, until cleared --\nhow UUITextHyperlink shows a link hovered or pressed. InTagIndex indexes GetRichTextCustomTagArray (a link is a\ntag too). The colour is applied when the text is painted, so this repaints the text and never lays it out again.\nIt belongs to the tag at InTagIndex now: a layout that puts another tag at that index -- the text edited, a tag\nadded in front -- takes it off, rather than colour a tag nobody chose."
    text  "用 InColor 绘制某个富文本标签的字形，而不是标记赋予它们的颜色，直到清除——\nUUITextHyperlink 就是这样显示悬停或按下的链接。InTagIndex 索引 GetRichTextCustomTagArray（链接也\n是一种标签）。颜色在文本绘制时应用，因此这只会重绘文本，绝不重新布局。\n它现在属于 InTagIndex 处的标签：若布局把另一个标签放到该索引——文本被编辑、前方插入了标签\n——就会将其移除，而不是给没人选择的标签上色。"
    state machine
}

DreamText:SmallTextRaster {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:SmallTextRaster
    src   "Off keeps this text on its font's distance field at every size. Auto lets small sizes draw from hinted coverage\nglyphs where that can be exact (UDreamGUISettings::bSmallTextCoverage says where): crisper at 10-20 px, the same\nlayout, carets and selection."
    text  "关闭时，此文本在任何字号下都使用字体的距离场。自动则允许小字号从可精确呈现的提示覆盖\n字形绘制（UDreamGUISettings::bSmallTextCoverage 决定在何处）：10-20 px 下更清晰，布局、\n光标和选区不变。"
    state machine
}

DreamText:TabSize {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:TabSize
    src   "Tab stops, in spaces of the font at the text's size (plus letter spacing), from the line's start edge: CSS tab-size,\n8 as browsers have it. A tab narrower than half a space jumps to the next stop; 0 makes a tab take no room."
    text  "制表位，以文本字号下字体的空格宽度（加上字距）为单位，从行的起始边缘算起：即 CSS tab-size，\n默认与浏览器一致为 8。小于半个空格的制表符跳到下一个制表位；0 使制表符不占空间。"
    state machine
}

DreamText:TextJustify {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:TextJustify
    src   "Where a justified line (HAlign Justify) gets its extra room: after word separators, between CJK characters, or everywhere."
    text  "两端对齐的行（HAlign Justify）从何处获得额外空间：单词分隔符之后、CJK 字符之间，或任意位置。"
    state machine
}

DreamText:TextStyle {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:TextStyle
    src   "Outline, underlay, glow and fill look, drawn by the built-in shader. Needs a distance-field font\n(OutlineMultiChannel source) and \"Use Built-in UI Shader\" on; has no effect with a custom material."
    text  "由内置着色器绘制的轮廓、衬底、发光和填充效果。需要距离场字体\n（OutlineMultiChannel 源）并开启“Use Built-in UI Shader”；使用自定义材质时无效。"
    state machine
}

DreamText:TextTransform {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:TextTransform
    src   "Case the text is drawn in. The Text property keeps what was authored; this is presentation only."
    text  "绘制文本时使用的大小写。Text 属性保留原始内容；此项仅影响显示。"
    state machine
}

DreamText:TryClickHyperlinkAtWorldPosition {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:TryClickHyperlinkAtWorldPosition
    src   "Hit-tests the point and, on a hit, broadcasts OnHyperlinkClicked. True when a link was hit."
    text  "对该点进行命中测试，命中时广播 OnHyperlinkClicked。命中链接时返回 true。"
    state machine
}

DreamText:UnregisterPerCharacterAnimation {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:UnregisterPerCharacterAnimation
    src   "The animator is done with this text's characters; see RegisterPerCharacterAnimation."
    text  "动画器已完成对该文本字符的处理；请参阅 RegisterPerCharacterAnimation。"
    state machine
}

DreamText:WrapTextAt {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:WrapTextAt
    src   "Wrap the text at this width instead of at the content box's, UMG's WrapTextAt. Zero or less\nkeeps the content box, which is the usual case.\n\nWorth having separately because the box is also what the text is ALIGNED in: a narrower wrap\nwidth gives a narrow column of text that still centres over the full widget, which the box\nalone cannot express. It does not truncate -- Truncate and Ellipsis still measure against the\nbox, since what they are about is what fits on screen."
    text  "按此宽度而非内容框宽度换行文本，即 UMG 的 WrapTextAt。为零或更小\n则保持内容框，这是常见情况。\n\n之所以单独设置，是因为内容框同时也是文本对齐的依据：较小的换行\n宽度会得到较窄的文本列，但仍会在整个控件上居中，这是单靠内容框\n无法表达的。它不会截断——Truncate 和 Ellipsis 仍按内容框\n测量，因为它们关心的是屏幕上能放下多少。"
    state machine
}

DreamTextHyperlinkEvent__DelegateSignature {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamTextHyperlinkEvent__DelegateSignature
    src   "A `<a=Id>` range was clicked; Id is what the markup named it."
    text  "点击了 `<a=Id>...</a>` 范围；Id 是标记中为其指定的名称。"
    state machine
}

EDreamTextSmallTextRaster {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#EDreamTextSmallTextRaster
    src   "Whether a text may draw its small sizes from hinted coverage glyphs rather than from its font's distance field."
