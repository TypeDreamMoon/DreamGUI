    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:RichTextImageData
    src   "rich text image data for rendering image inside UIText"
    text  "用于在 UIText 中渲染图像的富文本图像数据。"
    state machine
}

DreamText:RichTextTagFilterFlags {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:RichTextTagFilterFlags
    src   "Flags to enable/disable rich text tag."
    text  "用于启用/禁用富文本标签的标志。"
    state machine
