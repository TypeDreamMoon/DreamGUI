DreamText:OverrideMaterial {
    at    Source/DreamGUI/Public/Core/Components/DreamText.h#DreamText:OverrideMaterial
    src   "Use a custom material to render this text"
    text  "使用自定义材质来渲染此文本。"
    state machine
