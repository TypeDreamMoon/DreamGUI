    at    Source/DreamGUI/Public/Core/DreamGUISettings.h#DreamGUISettings:bFocusVisibleOnlyFromKeys
    src   "Draw the focus -- a control's Focused look and the focus ring -- only when keys or a pad put it there, as CSS's\n:focus-visible does: a clicked button is not drawn focused. Off: focus is always drawn."
    text  "Draw the focus -- a control's Focused look and the focus ring -- only when keys or a pad put it there, as CSS's\n:focus-visible does: a clicked button is not drawn focused. Off: focus is always drawn."
    state machine
}

