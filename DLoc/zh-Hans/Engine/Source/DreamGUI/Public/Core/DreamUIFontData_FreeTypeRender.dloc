EDreamUIFontVerticalMetrics {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_FreeTypeRender.h#EDreamUIFontVerticalMetrics
    src   "Which of a face's own vertical metrics its ascent, descent and line spacing are read from."
    text  "获取字体自身的垂直指标，例如上标、下标和行间距。"
    state machine
}

EDreamUIFontVerticalMetrics.FreeType {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_FreeTypeRender.h#EDreamUIFontVerticalMetrics:FreeType
    src   "FreeType's size metrics: the hhea ascender, descender and line gap, grid-fitted (ascender rounded up, descender down, line spacing to the nearest pixel). What DreamGUI has always used."
    text  "FreeType 的尺寸指标：hhea 的上标、下标和行间距，经过网格拟合（上标向上取整，下标向下取整，行间距四舍五入）。DreamGUI 始终使用的指标。"
    state machine
}

EDreamUIFontVerticalMetrics.Hhea {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_FreeTypeRender.h#EDreamUIFontVerticalMetrics:Hhea
    src   "The hhea ascender, descender and line gap, scaled without rounding. What CoreText on macOS lays text out with."
    text  "hhea 的上标、下标和行间距，未经缩放。macOS 上的 CoreText 使用的指标。"
    state machine
}

EDreamUIFontVerticalMetrics.Platform {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_FreeTypeRender.h#EDreamUIFontVerticalMetrics:Platform
    src   "What DirectWrite reports on Windows, and so what Chrome on Windows lays text out with: the typo metrics when the face sets\nOS/2 fsSelection bit 7 (USE_TYPO_METRICS), otherwise usWinAscent and usWinDescent with GDI's external leading as the line\ngap, max(0, hhea lineGap - ((usWinAscent + usWinDescent) - (hhea ascender - hhea descender))). The same rule on every\nplatform DreamGUI runs on. Falls back to hhea when the face has no OS/2 table."
    text  "DirectWrite 在 Windows 上报告的值，也是 Windows 上的 Chrome 排版文本所用的值：当面设置了\nOS/2 fsSelection 第 7 位（USE_TYPO_METRICS）时使用 typo 度量，否则使用 usWinAscent 和 usWinDescent，并以 GDI 的外部间距作为行\n间距，即 max(0, hhea lineGap - ((usWinAscent + usWinDescent) - (hhea ascender - hhea descender)))。DreamGUI 运行的每个\n平台都使用同一规则。当面没有 OS/2 表时回退到 hhea。"
    state machine
}

EDreamUIFontVerticalMetrics.Typo {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_FreeTypeRender.h#EDreamUIFontVerticalMetrics:Typo
    src   "OS/2 sTypoAscender, sTypoDescender and sTypoLineGap, scaled without rounding: the metrics the OpenType spec recommends for line layout. Falls back to hhea when the face has no OS/2 table."
    text  "OS/2 的 sTypoAscender、sTypoDescender 和 sTypoLineGap，未经缩放：OpenType 规范推荐的用于行布局的指标。如果字体没有 OS/2 表，则回退到 hhea。"
    state machine
}

EDreamUIFontVerticalMetrics.Win {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_FreeTypeRender.h#EDreamUIFontVerticalMetrics:Win
    src   "OS/2 usWinAscent and usWinDescent with no line gap: GDI's line box, tall enough that no glyph is clipped. Falls back to hhea when the face has no OS/2 table."
    text  "OS/2 的 usWinAscent 和 usWinDescent，不带行间距：GDI 的行盒，高度足以避免任何字形被裁剪。如果字体没有 OS/2 表，则回退到 hhea。"
    state machine
}
