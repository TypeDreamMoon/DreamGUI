namespace UObjectToolTips

DreamUIFontData_DistanceField {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField
    src   "SDF(Signed Distance Field) Font asset for render smooth scaled sdf text."
    text  "用于渲染平滑缩放 SDF 文本的 SDF (Signed Distance Field) 字体资源。"
    state machine
}

DreamUIFontData_DistanceField:AdditionalVerticalOffset {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:AdditionalVerticalOffset
    src   "Ascent and descent at SampleFontSize; negative means not cached yet."
    text  "在SampleFontSize处的字体上伸与下伸；负值表示尚未缓存。"
    state machine
}

DreamUIFontData_DistanceField:BoldRatio {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:BoldRatio
    src   "How much bolder a bold glyph is, in em of total stroke growth (half on each side). Applied as a\ndilation of the distance field, so it is continuous and costs no atlas space; the advance grows\nby the same amount. 0.04 is FreeType's own synthetic bold (1/24 em); the old 0.08 closed the\ncounters of CJK glyphs. A text can shift its weight on top of this with FDreamTextStyle::FaceDilate."
    text  "粗体字形比常规字形粗多少，以em为单位给出笔画总增量（每侧一半）。以距离场的\n膨胀实现，因此连续且不占用图集空间；步进量也按相同数值增大。0.04 是 FreeType\n自带的合成粗体（1/24 em）；旧的 0.08 会糊住 CJK 字形的字怀。文本还可以在此基础上\n用 FDreamTextStyle::FaceDilate 再调整字重。"
    state machine
}

DreamUIFontData_DistanceField:CoverageHinting {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:CoverageHinting
    src   "Which hinter shapes the coverage glyphs."
    text  "哪个 hinter 塑造覆盖字形。"
    state machine
}

DreamUIFontData_DistanceField:ItalicAngle {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:ItalicAngle
    src   "Angle of italic style in degree"
    text  "斜体样式的角度（单位：度）。"
    state machine
}

DreamUIFontData_DistanceField:LineHeight {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:LineHeight
    src   "-1 means not set yet. Transient, so widening it costs no serialized data."
    text  "-1 表示未设置。临时值，因此增大它不会占用序列化数据。"
    state machine
}

DreamUIFontData_DistanceField:SampleFontSize {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:SampleFontSize
    src   "Font size when render glyph."
    text  "渲染字形时的字体大小。"
    state machine
}

DreamUIFontData_DistanceField:SDFRadius {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:SDFRadius
    src   "The radius of the distance field in pixels at SampleFontSize. Normally 1/4 to 1/3 of SampleFontSize.\nIt is also as far as any text effect can reach: outline, glow and underlay are clamped to\nSDFRadius / SampleFontSize em outside the glyph, and the atlas cells grow with it."
    text  "在SampleFontSize处的字体距离场半径，以像素为单位。通常为SampleFontSize的1/4到1/3。\n它也是任何文字效果能达到的最远距离：描边、发光和底衬都被限制在字形外\nSDFRadius / SampleFontSize em以内，图集单元也随之增大。"
    state machine
}

DreamUIFontData_DistanceField:SdfSource {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:SdfSource
    src   "Outline multi-channel is the default, for assets saved before this property existed too."
    text  "默认情况下使用多通道轮廓，适用于在创建此属性之前保存的资源。"
    state machine
}

DreamUIFontData_DistanceField:SmallTextCoverage {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:SmallTextCoverage
    src   "Draw text this small on screen from hinted coverage glyphs -- crisp stems and four subpixel positions, as Chrome and\nSlate draw it -- rather than from the field, which reads soft below about 20 px. Needs the outline field (BGRA atlas).\nDecided per glyph item at paint time; a text can still opt out (UDreamText::SmallTextRaster)."
    text  "屏幕上的文字小到此值时，用经过微调的覆盖率字形绘制——笔画清晰，有四个亚像素位置，如同 Chrome 和\nSlate 的绘制方式——而不是用距离场，距离场在低于约 20 px 时显得发虚。需要轮廓场（BGRA 图集）。\n在绘制时按字形项逐项决定；文本仍可自行关闭（UDreamText::SmallTextRaster）。"
    state machine
}

DreamUIFontData_DistanceField:SmallTextMaxPixelSize {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:SmallTextMaxPixelSize
    src   "Device pixels per em up to which coverage glyphs are used; 0 or less takes the project's UDreamGUISettings::SmallTextMaxPixelSize."
    text  "在覆盖字形使用的像素数/em 为止的设备像素数；如果为 0 或更小，则使用项目的 UDreamGUISettings::SmallTextMaxPixelSize。"
    state machine
}

DreamUIFontData_DistanceField:VerticalOffset {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#DreamUIFontData_DistanceField:VerticalOffset
    src   "-1 means not set yet. Transient, so widening it costs no serialized data."
    text  "-1 表示未设置。临时值，因此增大它不会占用序列化数据。"
    state machine
}

EDreamUICoverageHinting {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#EDreamUICoverageHinting
    src   "Which hinter shapes a font's coverage glyphs. Value for value the rasterizer's EDreamGlyphHinting."
    text  "哪个 hinter 塑造字形的覆盖字形。其值与 rasterizer 的 EDreamGlyphHinting 值相同。"
    state machine
}

EDreamUICoverageHinting.Auto {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#EDreamUICoverageHinting:Auto
    src   "FreeType's light target: the face's own hints (vertical only) when it has them, the autohinter when it has none; the\nautohinter too at a fractional size on a face that would round its ppem, so the glyph keeps its size."
    text  "FreeType 的 light 目标：字体自带 hint 时用其自带的 hint（仅纵向），没有则用自动微调器；\n对于会把 ppem 取整的字体，在非整数大小时也用自动微调器，使字形保持其大小。"
    state machine
}

EDreamUICoverageHinting.Autohint {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#EDreamUICoverageHinting:Autohint
    src   "The autohinter (light target) for every face."
    text  "每个字体的自动提示（轻量级目标）。"
    state machine
}

EDreamUICoverageHinting.None {
    at    Source/DreamGUI/Public/Core/DreamUIFontData_DistanceField.h#EDreamUICoverageHinting:None
    src   "No hinting: the outline at its exact size, in four subpixel phases."
    text  "无提示：轮廓以其精确的大小显示，包含四个子像素阶段。"
    state machine
}

