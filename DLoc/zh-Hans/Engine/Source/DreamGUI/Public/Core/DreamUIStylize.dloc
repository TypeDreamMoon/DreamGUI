namespace UObjectToolTips

DreamStylizeLayer {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer
    src   "One layer of a stylize effect (UDreamStylizeEffect), in the order they are listed: each works on what the ones before it\nmade. Sizes are in units of the canvas, so the look keeps its size with the UI's scale; a pattern laid on the screen\n(scanlines, a halftone screen, the dither, grain) stays put as the element moves."
    text  "风格化效果（UDreamStylizeEffect）的一层，按列出顺序排列：每一层都作用于前一层所\n生成的结果。尺寸以画布为单位，因此外观会随UI的缩放保持原有大小；铺在屏幕上的图案\n（扫描线、半色调网屏、抖动、颗粒）会在元素移动时保持不动。"
    state machine
}

DreamStylizeLayer:AberrationAmount {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:AberrationAmount
    src   "How far red and blue are sampled apart: at the edge for Radial, everywhere for Directional."
    text  "红色和蓝色采样相距的距离：对于径向效果，在边缘处采样；对于定向效果，在所有位置采样。"
    state machine
}

DreamStylizeLayer:AberrationAngle {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:AberrationAngle
    src   "Directional: degrees, 0 up, clockwise."
    text  "定向效果：以度为单位，0 度为向上，顺时针方向。"
    state machine
}

DreamStylizeLayer:bAnimateGrain {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:bAnimateGrain
    src   "A new grain 24 times a second, rather than one that holds still."
    text  "每秒生成新的颗粒，而不是静态的颗粒。"
    state machine
}

DreamStylizeLayer:bCMYK {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:bCMYK
    src   "Four screens, cyan, magenta, yellow and black, rather than one of black ink."
    text  "青色、品红、黄色和黑色四个网屏，而不是一个黑色油墨网屏。"
    state machine
}

DreamStylizeLayer:BlockSize {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:BlockSize
    src   "The height of a shifted block, and the most it shifts."
    text  "错位块的高度，以及它的最大偏移量。"
    state machine
}

DreamStylizeLayer:CellSize {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:CellSize
    src   "A cell of the screen, and the screen's angle in degrees."
    text  "网屏的单元格大小，以及网屏的角度（度）。"
    state machine
}

DreamStylizeLayer:ColorSplit {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:ColorSplit
    src   "How far red and blue split apart."
    text  "红色与蓝色分离的距离。"
    state machine
