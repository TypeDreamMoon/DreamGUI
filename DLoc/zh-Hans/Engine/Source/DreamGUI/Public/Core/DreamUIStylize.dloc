DreamStylizeLayer:Curvature {
    at    Source/DreamGUI/Public/Core/DreamUIStylize.h#DreamStylizeLayer:Curvature
    src   "How much the screen bulges: 0 flat."
    text  "网屏凸起的程度：0为平面。"
    state machine
