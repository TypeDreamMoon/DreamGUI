namespace UObjectToolTips

DreamUIRichTextCustomStyleData {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#DreamUIRichTextCustomStyleData
    src   "For rich text on UIText.\nAdd your own string as tag and customize your own style."
    text  "用于UIText上的多格式文本。\n添加你自己的字符串作为标签，并自定义你自己的样式。"
    state machine
}

DreamUIRichTextCustomStyleData:SetDataMap {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#DreamUIRichTextCustomStyleData:SetDataMap
    src   "Replace every style at once, and tell the texts using this asset to lay out again."
    text  "一次性替换所有样式，并让使用此资源的文本重新布局。"
    state machine
}

DreamUIRichTextCustomStyleItemData:bold {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#DreamUIRichTextCustomStyleItemData:bold
    src   "What boldType and friends replaced. A style used to force all four flags, so a custom tag inside\na <b> turned the bold off again; there was no way to say \"leave it alone\". These are only still\nhere to carry an asset authored before the enums, and UpgradeLegacyBools folds them in on load."
    text  "boldType及其同类项所取代的内容。该样式过去会强制设置全部四个标志，因此在<b>加粗</b>区间内插入的自定义标签\n又会把粗体关掉；没有办法表示“保持原样”。保留这些属性\n只是为了承载在枚举之前创建的资源，UpgradeLegacyBools会在加载时将它们合并进来。"
    state machine
}

DreamUIRichTextCustomStyleItemData:paint {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#DreamUIRichTextCustomStyleItemData:paint
    src   "paintType Set: what the run is painted with -- its preset's gradient, or its gradient. Its bEnabled is not read."
    text  "paintType为Set：该文本段用什么来绘制——其预设的渐变，或它自身的渐变。不读取其bEnabled。"
    state machine
}

EDreamUIRichTextCustomStyleData_BoolType {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#EDreamUIRichTextCustomStyleData_BoolType
    src   "Same three states size, colour and sup/sub already had, for the four font-style flags."
    text  "与大小、颜色和上/下标已有的三种状态相同，只是用于四个字体样式标志。"
    state machine
}

EDreamUIRichTextCustomStyleData_PaintType {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#EDreamUIRichTextCustomStyleData_PaintType
    src   "What a custom style does to the paint of the text it encloses (FDreamTextStyle::FacePaint, `<gradient>`)."
}

EDreamUIRichTextCustomStyleData_PaintType.KeepOrigin {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#EDreamUIRichTextCustomStyleData_PaintType:KeepOrigin
    src   "Leave it: the paint of the tags around, or the text's own."
    text  "保持原样：保留周围标签的样式，或文本本身的样式。"
    state machine
}

EDreamUIRichTextCustomStyleData_PaintType.None {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#EDreamUIRichTextCustomStyleData_PaintType:None
    src   "No paint: the text inside is drawn in its colour, solid, even when the text itself is painted."
    text  "无填充：内部文本以其自身颜色绘制，不透明，即使文本本身被填充。"
    state machine
}

EDreamUIRichTextCustomStyleData_PaintType.Set {
    at    Source/DreamGUI/Public/Core/DreamUIRichTextCustomStyleData.h#EDreamUIRichTextCustomStyleData_PaintType:Set
    src   "Paint with the entry's paint, measured across the run -- and `<gradient=ThisEntrysName>` anywhere finds it too."
}
