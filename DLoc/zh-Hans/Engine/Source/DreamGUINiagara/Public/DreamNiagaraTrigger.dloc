namespace UObjectToolTips

DreamNiagaraTrigger {
    at    Source/DreamGUINiagara/Public/DreamNiagaraTrigger.h#DreamNiagaraTrigger
    src   "Plays a widget's Niagara system on the widget's pointer events -- a click, the pointer coming in and going out -- and when a\nprogress the trigger watches fills: the wiring every UI effect needs, without a Blueprint. Put it on the widget that takes the\npointer; the system is the visual of SystemWidget, else of this widget or the first below it that has one."
    text  "在控件的指针事件（点击、指针移入和移出）发生时，以及触发器监视的\n进度填满时，播放控件的Niagara系统：这是每个UI效果都需要的连接，无需蓝图。将它放在接收\n指针的控件上；该系统是SystemWidget的视觉，否则是此控件或其下方第一个拥有该系统的控件的视觉。"
    state machine
}

DreamNiagaraTrigger:ClickAddsProgress {
    at    Source/DreamGUINiagara/Public/DreamNiagaraTrigger.h#DreamNiagaraTrigger:ClickAddsProgress
    src   "What a click adds to the progress (a charge bar): 0 adds nothing. A full bar starts again from 0 at the next click."
    text  "点击为进度（充能条）增加多少：0表示不增加。满条后，下次点击时会从0重新开始。"
    state machine
}

DreamNiagaraTrigger:FindSystem {
    at    Source/DreamGUINiagara/Public/DreamNiagaraTrigger.h#DreamNiagaraTrigger:FindSystem
    src   "The Niagara system the trigger plays."
    text  "触发器播放的Niagara系统。"
    state machine
}

DreamNiagaraTrigger:Fire {
    at    Source/DreamGUINiagara/Public/DreamNiagaraTrigger.h#DreamNiagaraTrigger:Fire
    src   "Does InAction now; a pointer action takes the last pointer position the trigger saw, else the centre."
    text  "立即执行InAction；指针操作会采用触发器最近看到的指针位置，否则采用中心位置。"
    state machine
}

DreamNiagaraTrigger:FlightTarget {
    at    Source/DreamGUINiagara/Public/DreamNiagaraTrigger.h#DreamNiagaraTrigger:FlightTarget
    src   "Where BurstToTarget sends its particles."
    text  "BurstToTarget将粒子发送到的位置。"
    state machine
}

