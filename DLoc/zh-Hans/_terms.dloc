dloc 1
culture zh-Hans
terms

// The UE editor's own Chinese words (Engine/Content/Localization/*/zh-Hans), so DreamGUI reads like the editor around it.
term "Widget" { text "控件" }
term "Blueprint" { text "蓝图" }
term "Designer" { text "设计器" }
term "Hierarchy" { text "层级" }
term "Details" { text "细节" }
term "Anchor" { text "锚点" }
