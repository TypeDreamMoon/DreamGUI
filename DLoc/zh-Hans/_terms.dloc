term "Padding" { text "填充" }
term "Slot" { text "插槽" }
term "Canvas Panel" { text "画布面板" }
term "Visibility" { text "可视性" }
term "Render Transform" { text "渲染变换" }
term "Pivot" { text "枢轴点" }
term "Opacity" { text "不透明度" }
term "Tint" { text "着色" }
term "Brush" { text "笔刷" }
term "Font" { text "字体" }
term "Material" { text "材质" }
term "Texture" { text "纹理" }
term "Timeline" { text "时间轴" }
term "Viewport" { text "视口" }
term "Component" { text "组件" }
term "Variable" { text "变量" }
term "Preview" { text "预览" }
term "Asset" { text "资产" }
term "Content Browser" { text "内容浏览器" }
term "Outliner" { text "大纲视图" }
term "Binding" { text "绑定" }
term "Preset" { text "预设" }
term "Blend Mode" { text "混合模式" }
term "Corner Radius" { text "角半径" }
term "Background Blur" { text "背景模糊" }
term "Screen Space" { text "屏幕空间" }
term "Keyframe" { text "关键帧" }
term "Snapshot" { text "快照" }
term "Glyph" { text "字形" }
term "Baseline" { text "基线" }
term "Clipping" { text "裁剪" }
term "Pixel Snapping" { text "像素对齐" }
term "Rich Text" { text "多格式文本" }
term "Text Block" { text "文本块" }
