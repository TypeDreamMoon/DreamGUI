// DreamGUI's layer styles follow Photoshop, so their Chinese names do too.
term "Layer Style" { text "图层样式" }
term "Drop Shadow" { text "投影" }
term "Inner Shadow" { text "内阴影" }
term "Outer Glow" { text "外发光" }
term "Inner Glow" { text "内发光" }
term "Stroke" { text "描边" }
term "Gradient" { text "渐变" }
term "Mask" { text "遮罩" }

// Names that stay as they are.
keep "DreamGUI"
keep "DreamTween"
keep "DreamLoc"
keep "DreamShader"
keep "UMG"
keep "Slate"
keep "PIE"
keep "RHI"
keep "MSDF"
keep "DUI"
